<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ADR-0023/#95：S1 图标实现独立成集（IconAssetService + IconsModuleRegistrar）——
         解 IShortcutTargetResolver（SPI）归属死结：消费方随 S1 离开 Core，SPI #96 随
         Programs.Contracts 迁出（#96 已落地）。依赖方向：StarPie.Icons → StarPie.Icons.Contracts
         （契约）+ StarPie.Programs.Contracts（SPI 消费，.lnk 解析经 M3 契约边）
         + StarPie.Core（S2 AppDataPaths 默认数据目录提供，共享基建例外）；无 Core → Icons
         反向。实现 runtime 只被 Host/注册器/测试引用，业务模块零引用（模块 runtime 互引
         清零仍成立）。
         DI 注册经 IconsModuleRegistrar（RegisterServices）下放本程序集，组合根仍唯一
         BuildServiceProvider。 -->
    <UseWPF>true</UseWPF>
    <AssemblyName>StarPie.Icons</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- IconsModuleRegistrar 直接使用 MS.DI（IServiceCollection 注册面；与其它模块注册器
         csproj 一致，自 ADR-0021/#92 Core 移除该包后不再经共享内核传递）。 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- P1.3/#112：headless 契约/模型随 SDK 收口迁入 StarPie.Sdk（IconCatalog/CustomIconItem/
         VectorIconItem；IIconAssetService 仍驻 Icons.Contracts，WPF 契约件留 P1.4） -->
    <ProjectReference Include="..\StarPie.Sdk\StarPie.Sdk.csproj" />
    <!-- ADR-0023/#95：S1 契约（IIconAssetService/IconCatalog/CustomIconItem/VectorIconItem） -->
    <ProjectReference Include="..\StarPie.Icons.Contracts\StarPie.Icons.Contracts.csproj" />
    <!-- ADR-0023/#96：IconAssetService .lnk 解析依赖的 SPI IShortcutTargetResolver 已随
         M3 契约下沉 Programs.Contracts（命名空间 StarPie.Services.Icons 不变） -->
    <ProjectReference Include="..\StarPie.Programs.Contracts\StarPie.Programs.Contracts.csproj" />
    <!-- 共享内核 S2 AppDataPaths（IconAssetService 默认数据目录提供）——共享基建例外，
         与 SPI 无关，本引用不随 #96 删除 -->
    <ProjectReference Include="..\StarPie.Core\StarPie.Core.csproj" />
  </ItemGroup>

</Project>
