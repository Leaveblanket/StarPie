<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- B4/#77：M3 程序扫描与目录模块程序集（首个独立模块程序集，ADR-0016 决策 1/12）。
         B10/#83：命名空间统一为 StarPie.* 前缀替换，RootNamespace=StarPie。
         ADR-0019/#87：M3 边界收口——单向依赖 Core（IShortcutTargetResolver 契约驻共享内核，
         扫描经 Core 契约注入），不再引用 Host/其它业务模块（依赖方向见 assemblies.md §3）。 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>StarPie.Programs</AssemblyName>
    <RootNamespace>StarPie</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- ProgramsModuleRegistrar 直接使用 MS.DI（IServiceCollection 注册面）；自 ADR-0021/#92
         Core 移除该包后不再经共享内核传递，本模块显式声明（与其它模块注册器 csproj 一致）。 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-0019/#87：M3 → Core 单向（IShortcutTargetResolver/IIconAssetService 契约） -->
    <ProjectReference Include="..\StarPie.Core\StarPie.Core.csproj" />
  </ItemGroup>

</Project>
