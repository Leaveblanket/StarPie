<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- B4/#77：M3 程序扫描与目录模块程序集（首个独立模块程序集，ADR-0016 决策 1/12）。
         B10/#83：命名空间统一为 StarPie.* 前缀替换，RootNamespace=StarPie。
         ADR-0019/#87：M3 边界收口——单向依赖 Core（IShortcutTargetResolver 契约驻共享内核，
         扫描经 Core 契约注入），不再引用 Host/其它业务模块（依赖方向见 assemblies.md §3）。
         ADR-0023/#96：M3 扫描/SPI 契约随实现方下沉（IProgramScanner/ProgramEntry/
         ProgramCatalog/IShortcutTargetResolver 迁出 Core），P1.4/#113 随 SDK 的 WPF 面收口
         迁入 StarPie.Sdk.Wpf（原 Programs.Contracts/Icons.Contracts 暂留空壳）；
         本 runtime 只引用 Sdk/Sdk.Wpf，不再引用共享内核 Core/其它业务模块。 -->
    <UseWPF>true</UseWPF>
    <AssemblyName>StarPie.Programs</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- ProgramsModuleRegistrar 直接使用 MS.DI（IServiceCollection 注册面）；自 ADR-0021/#92
         Core 移除该包后不再经共享内核传递，本模块显式声明（与其它模块注册器 csproj 一致）。 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- P1.4/#113：SDK WPF 契约面（原 Programs.Contracts 的扫描三件 + SPI 与
         Icons.Contracts 的 IIconAssetService 随 SDK 收口迁入 StarPie.Sdk.Wpf，命名空间不变） -->
    <ProjectReference Include="..\StarPie.Sdk.Wpf\StarPie.Sdk.Wpf.csproj" />
  </ItemGroup>

</Project>
