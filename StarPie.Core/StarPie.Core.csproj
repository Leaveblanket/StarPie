<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- B2/#75：共享内核程序集（S1–S6 合并 + Models，ADR-0016 决策 1/12）。
         RootNamespace 保持 WinPieGestures：B10 前命名空间不随程序集改名，
         并让 resx 强类型生成类（VocaDb.ResXFileCodeGenerator）继续落在
         WinPieGestures.Services.Localization。 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>StarPie.Core</AssemblyName>
    <RootNamespace>WinPieGestures</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <!-- ADR-0013/#44：resx 强类型资源生成随资源迁入 Core（原 exe csproj 条目随 B2 移除） -->
    <PackageReference Include="VocaDb.ResXFileCodeGenerator" Version="3.2.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Services\Localization\Strings*.resx">
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

</Project>
