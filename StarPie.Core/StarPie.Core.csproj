<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 设计期投影壳：运行时件（S2 Configuration/S3 Localization）已迁 StarPie.Host 内核，
         本集只余设计期字符串字典（Page 编译的惰性 BAML，仅供各 UI 工程
         Properties/DesignTimeResources.xaml 以 pack URI 设计期合并，运行时永不自动合并；
         见 design-time-preview.md）。保留 WPF 类库形态是 Page 编译的前提；
         归并期含 UI 工程以本集引用解析该 pack URI。 -->
    <UseWPF>true</UseWPF>
    <AssemblyName>StarPie.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 设计期字符串字典（签入生成物，由同目录生成脚本从 Host 内核的 Strings.resx 派生）。 -->
    <Page Update="Services\Localization\DesignTimeStrings.xaml" />
  </ItemGroup>

</Project>
