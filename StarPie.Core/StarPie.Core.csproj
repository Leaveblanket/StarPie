<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- B2/#75：共享内核程序集（S1–S6 合并 + Models，ADR-0016 决策 1/12）。
         B10/#83：命名空间统一为 StarPie.* 前缀替换（跨程序集共享命名空间树），
         RootNamespace=StarPie 使 resx 强类型生成类（VocaDb.ResXFileCodeGenerator）
         落在 StarPie.Services.Localization。 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>StarPie.Core</AssemblyName>
    <RootNamespace>StarPie</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- ADR-0013/#44：resx 强类型资源生成随资源迁入 Core（原 exe csproj 条目随 B2 移除） -->
    <PackageReference Include="VocaDb.ResXFileCodeGenerator" Version="3.2.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Services\Localization\Strings*.resx">
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-0025/#101：设计期字符串字典（签入生成物，由同目录生成脚本从 Strings.resx 派生）
         Page 编译为惰性 BAML，仅供各 UI 工程 Properties/DesignTimeResources.xaml 资源锚
         以 pack URI 设计期合并；运行时永不自动合并。 -->
    <Page Update="Services\Localization\DesignTimeStrings.xaml" />
  </ItemGroup>

</Project>
