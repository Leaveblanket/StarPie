<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- B10/#83：测试命名空间统一为 StarPie.Tests（平铺于工程根，RootNamespace 与声明对齐） -->
    <RootNamespace>StarPie.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StarPie\StarPie.csproj" />
    <!-- ADR-0016/B2：测试工程显式引用各程序集，不依赖传递引用 -->
    <ProjectReference Include="..\StarPie.Core\StarPie.Core.csproj" />
    <!-- ADR-0023/#95：S1 契约独立成集（IIconAssetService/IconCatalog/条目类型/
         IconCatalogTests/TestIconAssetService 直用） -->
    <ProjectReference Include="..\StarPie.Icons.Contracts\StarPie.Icons.Contracts.csproj" />
    <!-- ADR-0023/#95：S1 实现 runtime（IconAssetService/IconsModuleRegistrar 直用，
         IconsAssemblyPlacementTests 断言归属/依赖） -->
    <ProjectReference Include="..\StarPie.Icons\StarPie.Icons.csproj" />
    <!-- ADR-0020/#88：S6 对话框实现程序集（DialogService/对话框 VM/Window 等测试直用） -->
    <ProjectReference Include="..\StarPie.Dialogs\StarPie.Dialogs.csproj" />
    <!-- ADR-0023/#96：S6 契约独立成集（IDialogService/结果 record 直用，
         Dialogs/SharedUi 等 PlacementTests 断言归属） -->
    <ProjectReference Include="..\StarPie.Dialogs.Contracts\StarPie.Dialogs.Contracts.csproj" />
    <!-- ADR-0016/B4：#77 M3 模块程序集（ProgramCatalog/ShortcutResolver/ProgramEntry 等测试直用） -->
    <ProjectReference Include="..\StarPie.Programs\StarPie.Programs.csproj" />
    <!-- ADR-0023/#96：M3 扫描契约独立成集（IProgramScanner/ProgramEntry/ProgramCatalog/
         IShortcutTargetResolver 直用，Programs 等 PlacementTests 断言归属） -->
    <ProjectReference Include="..\StarPie.Programs.Contracts\StarPie.Programs.Contracts.csproj" />
    <!-- ADR-0016/B6：#79 M5 模块程序集（GeneralSettingsViewModel/AboutViewModel/ShellModuleRegistrar 等测试直用） -->
    <ProjectReference Include="..\StarPie.Shell\StarPie.Shell.csproj" />
    <!-- ADR-0016/B7：#80 M4 界面主题模块程序集（ThemeService/ThemePaletteManager/InterfaceThemeSettingsViewModel/ThemeModuleRegistrar 等测试直用） -->
    <ProjectReference Include="..\StarPie.Theme\StarPie.Theme.csproj" />
    <!-- ADR-0023/#97：M4 主题契约独立成集（IThemeService 直用，Theme/SharedUi 等
         PlacementTests 断言归属） -->
    <ProjectReference Include="..\StarPie.Theme.Contracts\StarPie.Theme.Contracts.csproj" />
    <!-- ADR-0016/B8：#81 M2 轮盘与渲染模块程序集（WheelViewModel/RadialWindow/渲染器/配色/
         WheelFactory/WheelModuleRegistrar/CoreIcon* 转换器等测试直用） -->
    <ProjectReference Include="..\StarPie.Wheel\StarPie.Wheel.csproj" />
    <!-- ADR-0023/#97：M2 轮盘契约独立成集（IWheelFactory/IWheelViewModel/IWheelAppearanceState
         直用，Wheel 等 PlacementTests 断言归属） -->
    <ProjectReference Include="..\StarPie.Wheel.Contracts\StarPie.Wheel.Contracts.csproj" />
    <!-- ADR-0016/B9：#82 M1 手势与动作模块程序集（MouseHook/GestureEngine/ActionExecutor/
         BehaviorSettingsViewModel/ProfileListViewModel/SlotViewModel/Trigger+Gestures 页/
         GesturesModuleRegistrar 等测试直用） -->
    <ProjectReference Include="..\StarPie.Gestures\StarPie.Gestures.csproj" />
    <!-- ADR-0023/#97：M1 预览 Profile 契约独立成集（IProfilePreviewSource 直用，Wheel/
         Gestures/ProfileList 等测试与替身断言归属） -->
    <ProjectReference Include="..\StarPie.Gestures.Contracts\StarPie.Gestures.Contracts.csproj" />
  </ItemGroup>

</Project>
