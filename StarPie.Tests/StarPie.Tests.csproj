<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <!-- xUnit.net v3 的测试工程是可独立执行体，运行器入口点随包引入 -->
    <OutputType>Exe</OutputType>
    <!-- B10/#83：测试命名空间统一为 StarPie.Tests（平铺于工程根，RootNamespace 与声明对齐；
         TFM / 可空性 / 隐式 using 统一在仓库根 Directory.Build.props） -->
    <RootNamespace>StarPie.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit.net v3 的 mtp-v2 变体：以 Microsoft.Testing.Platform 2.x 进程内运行，
         dotnet test 走 MTP 模式（global.json 的 test.runner 开关）；VS/VS Code 的
         Test Explorer 由 MTP 原生支持接管，无需 VSTest 适配器与数据收集器 -->
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- #111 四集骨架：Ui 集（程序集名仍为 StarPie，发布产物 StarPie.exe）。 -->
    <ProjectReference Include="..\StarPie.Ui\StarPie.Ui.csproj" />
    <!-- #111 四集边界基线 + P1.3/#112 SDK 收口 + P1.4/#113 WPF 面收口：显式引用三集
         （不依赖传递引用），以加载程序集断言零 WPF / 零第三方包 / 唯一 XAML 与入口 / 跨集单向；
         迁入 SDK 的 headless 契约/模型（IDialogService、IWheel*、IProfilePreviewSource、
         IProgramScanner/ProgramEntry/ProgramCatalog/图标条目与 .lnk SPI 等）
         与迁入 Sdk.Wpf 的 WPF 契约件（IThemeService、IIconAssetService）亦经本引用直用。 -->
    <ProjectReference Include="..\StarPie.Sdk\StarPie.Sdk.csproj" />
    <ProjectReference Include="..\StarPie.Sdk.Wpf\StarPie.Sdk.Wpf.csproj" />
    <ProjectReference Include="..\StarPie.Host\StarPie.Host.csproj" />
    <!-- ADR-0016/B2：测试工程显式引用各程序集，不依赖传递引用；
         宿主内核运行时件（配置/本地化/图标目录/程序扫描）随 Host 引用直用，
         Core 只余设计期投影字典（HostBoundaryTests 断言其零导出类型） -->
    <ProjectReference Include="..\StarPie.Core\StarPie.Core.csproj" />
    <!-- P1.3/#112 + P1.4/#113：剩余四个被收口契约工程暂留空壳（内容分别迁 StarPie.Sdk /
         StarPie.Sdk.Wpf）——测试仍显式引用，以便加载全部应用程序集做「导出类型唯一 /
         空壳无导出」的机械断言（SdkBoundaryTests）；归并票（P1.6–P1.10）撤销工程时一并
         移除本组引用。 -->
    <ProjectReference Include="..\StarPie.Dialogs.Contracts\StarPie.Dialogs.Contracts.csproj" />
    <ProjectReference Include="..\StarPie.Gestures.Contracts\StarPie.Gestures.Contracts.csproj" />
    <ProjectReference Include="..\StarPie.Wheel.Contracts\StarPie.Wheel.Contracts.csproj" />
    <ProjectReference Include="..\StarPie.Theme.Contracts\StarPie.Theme.Contracts.csproj" />
    <!-- ADR-0020/#88：S6 对话框实现程序集（DialogService/对话框 VM/Window 等测试直用） -->
    <ProjectReference Include="..\StarPie.Dialogs\StarPie.Dialogs.csproj" />
    <!-- ADR-0016/B6：#79 M5 模块程序集（GeneralSettingsViewModel/ShellModuleRegistrar 等测试直用） -->
    <ProjectReference Include="..\StarPie.Shell\StarPie.Shell.csproj" />
    <!-- ADR-0016/B7：#80 M4 界面主题模块程序集（ThemeService/ThemePaletteManager/InterfaceThemeSettingsViewModel/ThemeModuleRegistrar 等测试直用） -->
    <ProjectReference Include="..\StarPie.Theme\StarPie.Theme.csproj" />
    <!-- ADR-0016/B8：#81 M2 轮盘与渲染模块程序集（WheelViewModel/RadialWindow/渲染器/配色/
         WheelFactory/WheelModuleRegistrar/CoreIcon* 转换器等测试直用） -->
    <ProjectReference Include="..\StarPie.Wheel\StarPie.Wheel.csproj" />
    <!-- ADR-0016/B9：#82 M1 手势与动作模块程序集（MouseHook/GestureEngine/ActionExecutor/
         BehaviorSettingsViewModel/ProfileListViewModel/SlotViewModel/Trigger+Gestures 页/
         GesturesModuleRegistrar 等测试直用） -->
    <ProjectReference Include="..\StarPie.Gestures\StarPie.Gestures.csproj" />
  </ItemGroup>

</Project>
