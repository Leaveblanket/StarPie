<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ADR-0027 / plugins.md §2：宿主内核零 WPF 引用、零 XAML，可 headless 单测——
         net10.0（不进 windows 段，WPF 引用在编译期即不可表达）；Host 不引用 StarPie.Sdk.Wpf。
         两条边界是 csproj 层面的事实，原机械化断言已下线（见 docs/adr/0050-test-scope.md）。 -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- ADR-0051：CsWin32 生成的互操作代码需要 unsafe；与 StarPie.Ui 同授权范围。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- 跨集只经 SDK：Host 只实现/消费 StarPie.Sdk 契约；内核运行时（Configuration/、
         Localization/、SystemIntegration/）与图标目录（Icons/）、程序扫描（Programs/）
         消费 SDK 模型与契约。 -->
    <ProjectReference Include="..\StarPie.Sdk\StarPie.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 防抖落盘编排订阅 IMessenger（内核服务，与页面 VM 的解耦经消息总线）。 -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- 本地化 resx 强类型资源生成（四语言：中性 zh-CN + 卫星 zh-TW/en/ja）。 -->
    <PackageReference Include="VocaDb.ResXFileCodeGenerator" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Win32 互操作源生成（ADR-0051）：声明清单为 NativeMethods.txt，生成物构建期产生、不入库；
         不加 IncludeAssets，让生成器拿到传递依赖 System.Memory。 -->
    <PackageReference Include="Microsoft.Windows.CsWin32" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings*.resx">
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

</Project>
