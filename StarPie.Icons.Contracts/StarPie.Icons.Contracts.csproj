<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ADR-0023/#95：S1 图标契约独立成集（IIconAssetService/IconCatalog/CustomIconItem/
         VectorIconItem）——契约随拥有方（S1 实现模块）入 StarPie.Icons.Contracts，模块 runtime
         只经 Contracts 通信；命名空间维持 StarPie.Services.Icons 不变（B10/#83 共享命名空间树）。
         契约程序集按需引用 WPF：IIconAssetService 签名含 System.Windows.Media 类型（ADR-0023 Q5
         先例：Contracts 形态与类型级分层无关）。无任何 ProjectReference（薄契约）。 -->
    <UseWPF>true</UseWPF>
    <AssemblyName>StarPie.Icons.Contracts</AssemblyName>
  </PropertyGroup>

</Project>
