<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- B9/#82：M1 手势与动作模块程序集（ADR-0016 决策 1/8/11/12，最后一个业务模块程序集——
         本批落地后除命名空间外 7 程序集目标态达成；B10/#83 命名空间统一收尾）。
         B10/#83：命名空间统一为 StarPie.* 前缀替换，RootNamespace=StarPie。
         依赖方向：StarPie.Gestures → StarPie.Core 单向 + StarPie.Gestures → StarPie.Wheel
         允许边（M1→M2，IWheelFactory/IWheelViewModel 消费，assemblies.md §3）；
         不引用 Host/其它业务模块（M2 侧也不反向引用 M1，跨 M 只经 Core 契约）。
         手势管线/动作执行/触发+手势设置页的 DI 注册与导航自报经
         GesturesModuleRegistrar（RegisterServices + RegisterNavigation）下放本程序集，
         组合根仍唯一 BuildServiceProvider。 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>StarPie.Gestures</AssemblyName>
    <RootNamespace>StarPie</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- B9/#82：M1 → Core 单向依赖（手势/动作消费 S1/S2/S3/S4/S6 契约与共享 Models；
         预览 Profile 只读契约 IProfilePreviewSource 在 Core ViewModels/Pages） -->
    <ProjectReference Include="..\StarPie.Core\StarPie.Core.csproj" />
    <!-- B9/#82：M1 → M2 允许边（GestureEngine/GestureController 只经 M2 侧 IWheelFactory /
         IWheelViewModel 接口消费瞬态轮盘，assemblies.md §3/ADR-0016 决策 11） -->
    <ProjectReference Include="..\StarPie.Wheel\StarPie.Wheel.csproj" />
  </ItemGroup>

</Project>
