<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- B9/#82：M1 手势与动作模块程序集（ADR-0016 决策 1/8/11/12；B10/#83 命名空间统一收尾）。
         B10/#83：命名空间统一为 StarPie.* 前缀替换，RootNamespace=StarPie。
         ADR-0023/#97：M1 出口契约 IProfilePreviewSource 随实现方下沉，M1→M2 runtime 允许边
         删除——本 runtime 只经 IWheelFactory/IWheelViewModel 契约接口消费瞬态轮盘，不引用
         Wheel runtime/其它业务模块（M2 侧也不反向引用 M1，跨 M 只经契约边）。
         P1.3/#112：IProfilePreviewSource/IWheelFactory/IWheelViewModel/IDialogService 等
         headless 契约随 SDK 收口迁入 StarPie.Sdk。
         依赖方向：StarPie.Gestures → StarPie.Sdk（headless 契约/模型）+
         StarPie.Host（宿主内核：S2 配置 / S3 本地化）单向 +
         StarPie.Sdk.Wpf（P1.4/#113 契约面：S1 图标契约四件与条目类型）；
         StarPie.Core 引用只为设计期资源锚解析设计期字符串字典的 pack URI（非运行时依赖）。
         手势管线/动作执行/触发+手势设置页的 DI 注册与导航自报经
         GesturesModuleRegistrar（RegisterServices + RegisterNavigation）下放本程序集，
         组合根仍唯一 BuildServiceProvider。 -->
    <UseWPF>true</UseWPF>
    <AssemblyName>StarPie.Gestures</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- M1 → 宿主内核单向依赖（手势/动作消费 S2 配置/S3 本地化接缝） -->
    <ProjectReference Include="..\StarPie.Host\StarPie.Host.csproj" />
    <!-- 设计期资源锚的 pack URI 解析目标（设计期字符串字典在 Core） -->
    <ProjectReference Include="..\StarPie.Core\StarPie.Core.csproj" />
    <!-- P1.3/#112：headless 契约/模型随 SDK 收口迁入 StarPie.Sdk（IProfilePreviewSource、
         IWheelFactory/IWheelViewModel、IDialogService、AppConfig/消息/导航目录等） -->
    <ProjectReference Include="..\StarPie.Sdk\StarPie.Sdk.csproj" />
    <!-- P1.4/#113：SDK WPF 契约面（SlotViewModel/ProfileListViewModel/GesturesModuleRegistrar
         消费 IIconAssetService；原 Icons.Contracts 随 SDK 收口迁入，命名空间不变） -->
    <ProjectReference Include="..\StarPie.Sdk.Wpf\StarPie.Sdk.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-0025/#101：VS 设计期资源锚（仅设计期合并，运行时不会自动合并）。 -->
    <Page Update="Properties\DesignTimeResources.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
      <ContainsDesignTimeResources>true</ContainsDesignTimeResources>
    </Page>
  </ItemGroup>

</Project>
