<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ADR-0020/#88：S6 对话框实现与界面程序集（实现 DialogService 与五对对话框 VM/Window +
         取色行为 SpectrumCanvasBehavior，命名空间沿用 StarPie.* 树，RootNamespace=StarPie）。
         ADR-0023/#96：契约随实现方下沉——IDialogService + 结果 record 独立成集、
         IProgramScanner/IShortcutTargetResolver 迁 StarPie.Programs.Contracts（程序扫描/.lnk
         解析经 Programs 契约边注入，不再经 Core）；P1.3/#112：IDialogService 与结果 record
         随 SDK 收口迁入 StarPie.Sdk（Dialogs.Contracts 暂留空壳）。
         依赖方向：StarPie.Dialogs → StarPie.Sdk（headless 契约/模型）+ StarPie.Host
         （宿主内核：S2 配置 / S3 本地化）单向 + StarPie.Sdk.Wpf（P1.4/#113 契约面：程序扫描/
         SPI、S1 图标与 M4 IThemeService 自旧三集随收口迁入——Dialogs→M4 runtime 允许边清零，
         窗口主题应用消费 IThemeService 经契约边）；StarPie.Core 引用只为设计期资源锚解析
         设计期字符串字典的 pack URI（非运行时依赖）；不引用 Programs
         runtime/其它业务模块（Dialogs→Programs 仅经契约面）。
         DI 注册经 DialogsModuleRegistrar（RegisterServices）下放本程序集，组合根仍唯一
         BuildServiceProvider；DialogService 裁决 public（宿主 SetOwner 装配面）。 -->
    <UseWPF>true</UseWPF>
    <AssemblyName>StarPie.Dialogs</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- P1.3/#112：headless 契约/模型随 SDK 收口迁入 StarPie.Sdk（IDialogService/结果 record、
         IconCatalog/条目类型、AppConfig 等消息与模型；Dialogs.Contracts 暂留空壳） -->
    <ProjectReference Include="..\StarPie.Sdk\StarPie.Sdk.csproj" />
    <!-- P1.4/#113：SDK WPF 契约面（程序扫描/SPI 自 Programs.Contracts、IThemeService 自
         Theme.Contracts、IIconAssetService/IconCatalog 自 Icons.Contracts 随 SDK 收口迁入；
         对话框链仅经契约边，命名空间不变） -->
    <ProjectReference Include="..\StarPie.Sdk.Wpf\StarPie.Sdk.Wpf.csproj" />
    <!-- 宿主内核（S2 配置/S3 本地化接缝） -->
    <ProjectReference Include="..\StarPie.Host\StarPie.Host.csproj" />
    <!-- 设计期资源锚的 pack URI 解析目标（设计期字符串字典在 Core） -->
    <ProjectReference Include="..\StarPie.Core\StarPie.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-0025/#101：VS 设计期资源锚（仅设计期合并，运行时不会自动合并）。 -->
    <Page Update="Properties\DesignTimeResources.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
      <ContainsDesignTimeResources>true</ContainsDesignTimeResources>
    </Page>
  </ItemGroup>

</Project>
