<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ADR-0020/#88：S6 对话框实现与界面程序集（契约留 Core：IDialogService + 结果
         record；实现 DialogService 与五对对话框 VM/Window + 取色行为 SpectrumCanvasBehavior
         随迁，命名空间沿用 StarPie.* 树，RootNamespace=StarPie）。
         ADR-0023/#96：契约随实现方下沉——IDialogService + 结果 record 迁
         StarPie.Dialogs.Contracts、IProgramScanner/IShortcutTargetResolver 迁
         StarPie.Programs.Contracts（程序扫描/.lnk 解析经 Programs 契约边注入，不再经 Core）。
         依赖方向：StarPie.Dialogs → Core 单向（S2/S3/S4 共享基建）+ Dialogs.Contracts +
         Programs.Contracts + Icons.Contracts + Theme.Contracts（ADR-0023/#97：Dialogs→M4
         runtime 允许边清零，窗口主题应用消费 IThemeService 改经契约边）；不引用 Programs
         runtime/Host/其它业务模块（Dialogs→Programs 仅经 Programs.Contracts）。
         DI 注册经 DialogsModuleRegistrar（RegisterServices）下放本程序集，组合根仍唯一
         BuildServiceProvider；DialogService 裁决 public（宿主 SetOwner 装配面）。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>StarPie.Dialogs</AssemblyName>
    <RootNamespace>StarPie</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-0023/#96：S6 契约（IDialogService/结果 record）随实现方下沉 Dialogs.Contracts -->
    <ProjectReference Include="..\StarPie.Dialogs.Contracts\StarPie.Dialogs.Contracts.csproj" />
    <!-- ADR-0023/#96：程序扫描/.lnk 契约（IProgramScanner/ProgramEntry/ProgramCatalog/
         IShortcutTargetResolver）随 M3 下沉 Programs.Contracts，对话框链仅经契约边 -->
    <ProjectReference Include="..\StarPie.Programs.Contracts\StarPie.Programs.Contracts.csproj" />
    <!-- 共享内核（S2 配置/S3 本地化/S4 消息/Models 等共享基建） -->
    <ProjectReference Include="..\StarPie.Core\StarPie.Core.csproj" />
    <!-- ADR-0023/#97：对话框窗口主题应用消费 M4 IThemeService（Dialogs→M4 runtime 允许边
         清零，改经 Theme.Contracts 契约边） -->
    <ProjectReference Include="..\StarPie.Theme.Contracts\StarPie.Theme.Contracts.csproj" />
    <!-- ADR-0023/#95：S1 契约独立成集（DialogService/IconPickerWindow 等消费
         IIconAssetService/IconCatalog/条目类型），不再经 Core 消费 S1 类型 -->
    <ProjectReference Include="..\StarPie.Icons.Contracts\StarPie.Icons.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-0025/#101：VS 设计期资源锚（仅设计期合并，运行时不会自动合并）。 -->
    <Page Update="Properties\DesignTimeResources.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
      <ContainsDesignTimeResources>true</ContainsDesignTimeResources>
    </Page>
  </ItemGroup>

</Project>
