<Window x:Class="P0.Plugin.Views.ProbeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="P0 Probe Window" Width="320" Height="180"
        WindowStartupLocation="Manual" Left="-2400" Top="-2400"
        ShowInTaskbar="False" WindowStyle="ToolWindow">
    <!-- P0 打样：插件窗口（BAML 解析 + 自有资源 + 绑定）。 -->
    <Window.Resources>
        <SolidColorBrush x:Key="WindowProbeBrush" Color="#FF3B82F6" />
    </Window.Resources>
    <Grid Margin="12">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="16"
                       Foreground="{StaticResource WindowProbeBrush}" />
            <TextBlock Text="plugin window" Opacity="0.6" />
        </StackPanel>
    </Grid>
</Window>
