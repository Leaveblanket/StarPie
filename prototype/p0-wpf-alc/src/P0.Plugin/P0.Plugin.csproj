<Project Sdk="Microsoft.NET.Sdk">

  <!-- P0 打样：模拟第三方 UI 插件包。
       契约集以 ExcludeAssets="runtime" 引用 —— 与目标态 §5.1 约束 3 一致：
       SDK/Sdk.Wpf 永不随包分发，包目录里不得出现 P0.Contracts.dll。 -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>P0.Plugin</AssemblyName>
    <RootNamespace>P0.Plugin</RootNamespace>
    <EnableDefaultPageItems>true</EnableDefaultPageItems>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\P0.Contracts\P0.Contracts.csproj" ExcludeAssets="runtime" Private="false" />
  </ItemGroup>

</Project>
