<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- B8/#81：M2 轮盘与渲染模块程序集（ADR-0016 决策 1/8/11/12）。
         B10/#83：命名空间统一为 StarPie.* 前缀替换，RootNamespace=StarPie。
         依赖方向：StarPie.Wheel → StarPie.Core 单向 + StarPie.Wheel → StarPie.Theme
         允许边（M2→M4，IThemeService 消费，assemblies.md §3）；
         ADR-0023/#96 起另经 Dialogs.Contracts 契约边消费 S6（IDialogService）；
         不引用 Host/其它业务模块（M1 手势侧自 B9/#82 起驻 StarPie.Gestures，只经
         IWheelFactory 接口消费）。
         WheelFactory/工厂接口随 M2 收编（D5，ADR-0016 决策 11）；轮盘外观设置子 VM
         与轮盘 VM/窗口/渲染器/配色/工厂的 DI 注册经 WheelModuleRegistrar.RegisterServices
         下放本程序集，组合根仍唯一 BuildServiceProvider。 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>StarPie.Wheel</AssemblyName>
    <RootNamespace>StarPie</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- B8/#81：M2 → Core 单向依赖（轮盘 VM/渲染器消费 S1/S2/S3/S4 契约与共享 Models；
         配色 WPF-free 值类型随 M2 物理收编于本集 Models，CustomColorPreset 仍居 Core Models） -->
    <ProjectReference Include="..\StarPie.Core\StarPie.Core.csproj" />
    <!-- B8/#81：M2 → M4 允许边（RadialWindow/WheelFactory 消费 IThemeService，assemblies.md §3） -->
    <ProjectReference Include="..\StarPie.Theme\StarPie.Theme.csproj" />
    <!-- ADR-0023/#95：S1 契约独立成集（RadialWindow/WheelFactory/WheelPreviewRenderer/
         WheelGeometry 消费 IIconAssetService/IconCatalog/条目类型），不再经 Core 消费 S1 类型 -->
    <ProjectReference Include="..\StarPie.Icons.Contracts\StarPie.Icons.Contracts.csproj" />
    <!-- ADR-0023/#96：S6 对话框契约独立成集（WheelAppearanceSettingsViewModel 消费
         IDialogService），不再经 Core 消费 S6 类型 -->
    <ProjectReference Include="..\StarPie.Dialogs.Contracts\StarPie.Dialogs.Contracts.csproj" />
  </ItemGroup>

</Project>
