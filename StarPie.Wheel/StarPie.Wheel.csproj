<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- B8/#81：M2 轮盘与渲染模块程序集（ADR-0016 决策 1/8/11/12）。
         B10/#83：命名空间统一为 StarPie.* 前缀替换，RootNamespace=StarPie。
         依赖方向：StarPie.Wheel → StarPie.Sdk（headless 契约/模型）+ StarPie.Host
         （宿主内核：S2 配置 / S3 本地化）单向 + StarPie.Sdk.Wpf（P1.4/#113 契约面：
         M2→M4 经 IThemeService、S1 经 IIconAssetService）；StarPie.Core 引用只为设计期
         资源锚解析设计期字符串字典的 pack URI（非运行时依赖）；不引用任何
         其它业务模块 runtime（M1 手势侧驻
         StarPie.Gestures，只经 SDK 的轮盘接口消费，runtime 互引清零）。
         工厂接口/轮盘 VM 接口/签名暴露件随 SDK 收口迁入 StarPie.Sdk（D5，ADR-0016 决策 11）；
         轮盘外观设置子 VM 与轮盘 VM/窗口/渲染器/配色/工厂的 DI 注册经
         WheelModuleRegistrar.RegisterServices 下放本程序集，组合根仍唯一 BuildServiceProvider。 -->
    <UseWPF>true</UseWPF>
    <AssemblyName>StarPie.Wheel</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- M2 → 宿主内核单向依赖（轮盘 VM/渲染器消费 S2 配置/S3 本地化接缝；
         配色 WPF-free 值类型物理收编于本集 Models） -->
    <ProjectReference Include="..\StarPie.Host\StarPie.Host.csproj" />
    <!-- 设计期资源锚的 pack URI 解析目标（设计期字符串字典在 Core） -->
    <ProjectReference Include="..\StarPie.Core\StarPie.Core.csproj" />
    <!-- P1.3/#112：headless 契约/模型随 SDK 收口迁入 StarPie.Sdk（IWheelFactory/IWheelViewModel/
         IWheelAppearanceState、IProfilePreviewSource、IDialogService、AppConfig/GesturePoint/
         WheelProfile 等） -->
    <ProjectReference Include="..\StarPie.Sdk\StarPie.Sdk.csproj" />
    <!-- SDK 的 WPF 契约面（主题与图标资产服务）：M2→M4 runtime 允许边与 S1 契约边
         统一经本引用，命名空间不变 -->
    <ProjectReference Include="..\StarPie.Sdk.Wpf\StarPie.Sdk.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-0025/#101：VS 设计期资源锚（仅设计期合并，运行时不会自动合并）。 -->
    <Page Update="Properties\DesignTimeResources.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
      <ContainsDesignTimeResources>true</ContainsDesignTimeResources>
    </Page>
  </ItemGroup>

</Project>
