<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ADR-0027/0028 / plugins.md §2/§5.1：SDK 的 WPF 类型契约面（插件可同时引用
         StarPie.Sdk 与 StarPie.Sdk.Wpf；ABI 政策独立编号、additive-only，见 §5.1 约束 8）。
         本集是契约面，不产出 XAML（四集中仅 Ui 含 XAML 与入口）。
         P1.4/#113：WPF 契约件自旧三集迁入（Services/Icons 图标四件 + .lnk SPI、
         Services/Programs 扫描三件、Services/Shell 主题服务），命名空间保持 StarPie.* 不变；
         ABI/装载政策骨架在 Compatibility/（UiSdkAbi + DefaultAlcPolicy），迁移期镜像旧相对路径。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF 契约件可组合 headless SDK 的模型/常量（跨集只经 SDK：Sdk.Wpf → Sdk 单向）。 -->
    <ProjectReference Include="..\StarPie.Sdk\StarPie.Sdk.csproj" />
  </ItemGroup>

</Project>
