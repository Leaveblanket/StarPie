<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ADR-0027/0028 / plugins.md §2/§5.1：SDK 的 WPF 类型契约面（插件可同时引用
         StarPie.Sdk 与 StarPie.Sdk.Wpf；ABI 政策独立编号、additive-only，见 §5.1 约束 8）。
         本集是契约面，不产出 XAML（四集中仅 Ui 含 XAML 与入口）。
         TFM 取仓库根 Directory.Build.props 的 windows 段（ADR-0026 运行时基线，单一来源）；
         只有收窄为 net10.0（零 WPF）的 Sdk/Host 才在工程级显式覆盖。
         本集承载 WPF 契约件（Services/Icons 图标资产服务契约、Services/Shell 主题服务；
         扫描三件与图标条目/.lnk SPI 属 headless 面），命名空间保持 StarPie.* 不变；
         ABI/装载政策在 Compatibility/（UiSdkAbi + DefaultAlcPolicy），
         源码树镜像旧相对路径。 -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF 契约件可组合 headless SDK 的模型/常量（跨集只经 SDK：Sdk.Wpf → Sdk 单向）。 -->
    <ProjectReference Include="..\StarPie.Sdk\StarPie.Sdk.csproj" />
  </ItemGroup>

</Project>
