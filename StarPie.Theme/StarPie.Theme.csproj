<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- B7/#80：M4 界面主题模块程序集（ADR-0016 决策 1/8/12）。
         B10/#83：命名空间统一为 StarPie.* 前缀替换，RootNamespace=StarPie。
         ADR-0023/#97：M4 出口契约 IThemeService 随实现方下沉 StarPie.Theme.Contracts，
         本 runtime 只引用自身契约程序集与 Core（S2/S3/S4 共享基建），不引用 Host/其它业务
         模块 runtime（Wheel/Dialogs 消费方改经 Theme.Contracts 契约边，本 runtime 只被
         Host/测试引用）。
         主题服务与主题设置子 VM 的 DI 注册经 ThemeModuleRegistrar.RegisterServices
         下放本程序集，组合根仍唯一 BuildServiceProvider；
         ThemePaletteManager 裁决为 public（Host AppHost 装配面，B6/#79 TrayIconManager 先例）。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>StarPie.Theme</AssemblyName>
    <RootNamespace>StarPie</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- B7/#80：M4 → Core 单向依赖（主题设置子 VM 消费 S2/S3/S4 契约与共享 Models） -->
    <ProjectReference Include="..\StarPie.Core\StarPie.Core.csproj" />
    <!-- ADR-0023/#97：M4 → Theme.Contracts（实现自有契约：ThemeService 实现
         IThemeService，ThemeModuleRegistrar 注册别名，自 StarPie.Theme 迁出） -->
    <ProjectReference Include="..\StarPie.Theme.Contracts\StarPie.Theme.Contracts.csproj" />
  </ItemGroup>

</Project>
