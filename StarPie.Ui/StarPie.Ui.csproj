<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- B10/#83 起：源码根命名空间 StarPie 与 AssemblyName 对齐；#111 工程目录/文件更名为
         StarPie.Ui（四集之一的 Ui 集，ADR-0027），程序集名与发布产物名保持 StarPie；
         TFM / 可空性 / 隐式 using / 分析器级别 / 根命名空间统一在仓库根 Directory.Build.props -->
    <UseWPF>true</UseWPF>
    <ApplicationIcon>assets\app_icon.ico</ApplicationIcon>
    <AssemblyName>StarPie</AssemblyName>
    <Title>StarPie</Title>
    <Product>StarPie</Product>
    <Company>StarPie Studio</Company>
    <Description>StarPie - 现代化高颜值 Windows 鼠标轮盘笔势与效率管理系统</Description>
    <Version>1.4.1</Version>
    <AssemblyVersion>1.4.1.0</AssemblyVersion>
    <FileVersion>1.4.1.0</FileVersion>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ui 集引用宿主内核、headless SDK 与 SDK 的 WPF 契约面
         （跨集单向：Ui → Host → Sdk，Ui → Sdk.Wpf → Sdk）。
         headless 契约/模型与 WPF 契约件（IThemeService/IIconAssetService 等）分别收口于
         StarPie.Sdk 与 StarPie.Sdk.Wpf。 -->
    <ProjectReference Include="..\StarPie.Sdk\StarPie.Sdk.csproj" />
    <ProjectReference Include="..\StarPie.Sdk.Wpf\StarPie.Sdk.Wpf.csproj" />
    <!-- 宿主内核（Kernel/Configuration 配置读写与防抖保存、Kernel/Localization 本地化实现）；
         WPF 适配件（DispatcherSaveDebouncer）驻本集 Adapters/，实现内核防抖接缝 -->
    <ProjectReference Include="..\StarPie.Host\StarPie.Host.csproj" />
    <!-- 设计期资源锚的 pack URI 解析目标（设计期字符串字典在 Core）；
         运行时内核（S2 配置 / S3 本地化）在 StarPie.Host -->
    <ProjectReference Include="..\StarPie.Core\StarPie.Core.csproj" />
    <!-- ADR-0020/#88：S6 对话框实现程序集显式引用（DialogService 实现与五对对话框
         VM/Window 随迁；组合根调 DialogsModuleRegistrar 注册 IDialogService DI、
         AppHost 建窗后调 DialogService.SetOwner 回填 Owner 装配面） -->
    <ProjectReference Include="..\StarPie.Dialogs\StarPie.Dialogs.csproj" />
    <!-- B6/#79：M5 模块程序集显式引用（TrayIconManager/MemoryOptimizer/General 设置面随迁；
         组合根调 ShellModuleRegistrar 装配导航与页面 VM DI、AppHost 装配托盘对象用） -->
    <ProjectReference Include="..\StarPie.Shell\StarPie.Shell.csproj" />
    <!-- B8/#81：M2 轮盘与渲染模块程序集显式引用（轮盘 VM/窗口/渲染器/配色/工厂随迁；
         组合根调 WheelModuleRegistrar 注册轮盘工厂与外观设置子 VM DI、外观聚合页经 Wheel
         引用 WheelAppearanceSettingsViewModel/IWheelAppearanceState/预览渲染器，
         M1 手势侧（GestureEngine）只经 IWheelFactory 接口消费） -->
    <ProjectReference Include="..\StarPie.Wheel\StarPie.Wheel.csproj" />
    <!-- B9/#82：M1 手势与动作模块程序集显式引用（手势管线/动作执行/触发+手势设置页随迁；
         组合根调 GesturesModuleRegistrar 装配导航与 M1 DI、AppHost 持有 MouseHook，
         手势侧只经 M2 IWheelFactory/IWheelViewModel 接口消费轮盘） -->
    <ProjectReference Include="..\StarPie.Gestures\StarPie.Gestures.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-0025/#101：VS 设计期资源锚（仅设计期合并，运行时不会自动合并）。 -->
    <Page Update="Properties\DesignTimeResources.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
      <ContainsDesignTimeResources>true</ContainsDesignTimeResources>
    </Page>
  </ItemGroup>

</Project>
