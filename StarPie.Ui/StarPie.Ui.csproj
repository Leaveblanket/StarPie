<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- B10/#83 起：源码根命名空间 StarPie 与 AssemblyName 对齐；#111 工程目录/文件更名为
         StarPie.Ui（四集之一的 Ui 集，ADR-0027），程序集名与发布产物名保持 StarPie；
         TFM / 可空性 / 隐式 using / 分析器级别 / 根命名空间统一在仓库根 Directory.Build.props -->
    <UseWPF>true</UseWPF>
    <ApplicationIcon>assets\app_icon.ico</ApplicationIcon>
    <AssemblyName>StarPie</AssemblyName>
    <Title>StarPie</Title>
    <Product>StarPie</Product>
    <Company>StarPie Studio</Company>
    <Description>StarPie - 现代化高颜值 Windows 鼠标轮盘笔势与效率管理系统</Description>
    <Version>1.4.1</Version>
    <AssemblyVersion>1.4.1.0</AssemblyVersion>
    <FileVersion>1.4.1.0</FileVersion>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- #111 四集骨架：Ui 集引用宿主内核、headless SDK 与 SDK 的 WPF 契约面
         （跨集单向：Ui → Host → Sdk，Ui → Sdk.Wpf → Sdk；各集内容随 P1.3–P1.10 迁入）。 -->
    <ProjectReference Include="..\StarPie.Sdk\StarPie.Sdk.csproj" />
    <ProjectReference Include="..\StarPie.Sdk.Wpf\StarPie.Sdk.Wpf.csproj" />
    <ProjectReference Include="..\StarPie.Host\StarPie.Host.csproj" />
    <!-- B2/#75：共享内核程序集引用（Models/S2/S3/S4/S1/S6 契约/S5 导航内核随迁） -->
    <ProjectReference Include="..\StarPie.Core\StarPie.Core.csproj" />
    <!-- ADR-0020/#88：S6 对话框实现程序集显式引用（DialogService 实现与五对对话框
         VM/Window 随迁；组合根调 DialogsModuleRegistrar 注册 IDialogService DI、
         AppHost 建窗后调 DialogService.SetOwner 回填 Owner 装配面） -->
    <ProjectReference Include="..\StarPie.Dialogs\StarPie.Dialogs.csproj" />
    <!-- ADR-0023/#96：S6 契约独立成集显式引用（NavigationExecutor/ShellViewModel 消费
         IDialogService/结果 record，不再经 Core 传递） -->
    <ProjectReference Include="..\StarPie.Dialogs.Contracts\StarPie.Dialogs.Contracts.csproj" />
    <!-- B4/#77：M3 模块程序集显式引用（ProgramScanner/ProgramCatalog/ShortcutResolver 随迁；
         ADR-0019/#87 起 M3 单向依赖 Core，组合根调 ProgramsModuleRegistrar 注册
         IShortcutTargetResolver 契约，扫描经 Core 契约注入） -->
    <ProjectReference Include="..\StarPie.Programs\StarPie.Programs.csproj" />
    <!-- ADR-0023/#96：M3 扫描契约独立成集显式引用（Composition 直用 IShortcutTargetResolver/
         IProgramScanner 契约面，不再经 Core 传递） -->
    <ProjectReference Include="..\StarPie.Programs.Contracts\StarPie.Programs.Contracts.csproj" />
    <!-- ADR-0023/#97：M4 主题契约独立成集显式引用（MainView/组合根消费 IThemeService 契约面） -->
    <ProjectReference Include="..\StarPie.Theme.Contracts\StarPie.Theme.Contracts.csproj" />
    <!-- ADR-0023/#97：M2 轮盘契约独立成集显式引用（外观页预览 code-behind 消费
         IWheelAppearanceState 只读状态接口） -->
    <ProjectReference Include="..\StarPie.Wheel.Contracts\StarPie.Wheel.Contracts.csproj" />
    <!-- ADR-0023/#97：M1 预览 Profile 契约独立成集显式引用（组合根/注释面消费
         IProfilePreviewSource，别名由 GesturesModuleRegistrar 注册） -->
    <ProjectReference Include="..\StarPie.Gestures.Contracts\StarPie.Gestures.Contracts.csproj" />
    <!-- B6/#79：M5 模块程序集显式引用（TrayIconManager/MemoryOptimizer/General 设置面随迁；
         组合根调 ShellModuleRegistrar 装配导航与页面 VM DI、AppHost 装配托盘对象用） -->
    <ProjectReference Include="..\StarPie.Shell\StarPie.Shell.csproj" />
    <!-- B7/#80：M4 界面主题模块程序集显式引用（ThemeService/ThemePaletteManager/主题字典/
         主题设置子 VM 随迁；组合根调 ThemeModuleRegistrar 注册服务与主题 VM DI、
         AppHost 装配 ThemePaletteManager 调色板换入面用） -->
    <ProjectReference Include="..\StarPie.Theme\StarPie.Theme.csproj" />
    <!-- B8/#81：M2 轮盘与渲染模块程序集显式引用（轮盘 VM/窗口/渲染器/配色/工厂随迁；
         组合根调 WheelModuleRegistrar 注册轮盘工厂与外观设置子 VM DI、外观聚合页经 Wheel
         引用 WheelAppearanceSettingsViewModel/IWheelAppearanceState/预览渲染器，
         M1 手势侧（GestureEngine）只经 IWheelFactory 接口消费） -->
    <ProjectReference Include="..\StarPie.Wheel\StarPie.Wheel.csproj" />
    <!-- B9/#82：M1 手势与动作模块程序集显式引用（手势管线/动作执行/触发+手势设置页随迁；
         组合根调 GesturesModuleRegistrar 装配导航与 M1 DI、AppHost 持有 MouseHook，
         手势侧只经 M2 IWheelFactory/IWheelViewModel 接口消费轮盘） -->
    <ProjectReference Include="..\StarPie.Gestures\StarPie.Gestures.csproj" />
    <!-- ADR-0023/#95：S1 契约独立成集——契约程序集显式引用（IIconAssetService 等类型面）；
         实现 runtime 显式引用（组合根调 IconsModuleRegistrar 注册 IIconAssetService） -->
    <ProjectReference Include="..\StarPie.Icons.Contracts\StarPie.Icons.Contracts.csproj" />
    <ProjectReference Include="..\StarPie.Icons\StarPie.Icons.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-0025/#101：VS 设计期资源锚（仅设计期合并，运行时不会自动合并）。 -->
    <Page Update="Properties\DesignTimeResources.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
      <ContainsDesignTimeResources>true</ContainsDesignTimeResources>
    </Page>
  </ItemGroup>

</Project>
