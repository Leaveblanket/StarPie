<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- B10/#83 起：源码根命名空间 StarPie 与 AssemblyName 对齐；#111 工程目录/文件更名为
         StarPie.Ui（四集之一的 Ui 集，ADR-0027），程序集名与发布产物名保持 StarPie；
         TFM / 可空性 / 隐式 using / 分析器级别 / 根命名空间统一在仓库根 Directory.Build.props -->
    <UseWPF>true</UseWPF>
    <ApplicationIcon>assets\app_icon.ico</ApplicationIcon>
    <AssemblyName>StarPie</AssemblyName>
    <Title>StarPie</Title>
    <Product>StarPie</Product>
    <Company>StarPie Studio</Company>
    <Description>StarPie - 现代化高颜值 Windows 鼠标轮盘笔势与效率管理系统</Description>
    <Version>1.4.1</Version>
    <AssemblyVersion>1.4.1.0</AssemblyVersion>
    <FileVersion>1.4.1.0</FileVersion>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ui 集引用宿主内核、headless SDK 与 SDK 的 WPF 契约面
         （跨集单向：Ui → Host → Sdk，Ui → Sdk.Wpf → Sdk）。
         headless 契约/模型与 WPF 契约件（IThemeService/IIconAssetService 等）分别收口于
         StarPie.Sdk 与 StarPie.Sdk.Wpf。 -->
    <ProjectReference Include="..\StarPie.Sdk\StarPie.Sdk.csproj" />
    <ProjectReference Include="..\StarPie.Sdk.Wpf\StarPie.Sdk.Wpf.csproj" />
    <!-- 宿主内核（Kernel/Configuration 配置读写与防抖保存、Kernel/Localization 本地化实现）；
         WPF 适配件（DispatcherSaveDebouncer）驻本集 Adapters/，实现内核防抖接缝 -->
    <ProjectReference Include="..\StarPie.Host\StarPie.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-0025/#101：VS 设计期资源锚（仅设计期合并，运行时不会自动合并）。 -->
    <Page Update="Properties\DesignTimeResources.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
      <ContainsDesignTimeResources>true</ContainsDesignTimeResources>
    </Page>
    <!-- 设计期字符串字典（签入生成物，由同目录生成脚本从 Host 内核的 Strings.resx 派生）：
         Page 编译为惰性 BAML，只被上面的资源锚以 pack URI 在设计期合并，运行时永不合并。 -->
    <Page Update="Services\Localization\DesignTimeStrings.xaml" />
  </ItemGroup>

  <!-- 随包 headless 插件打包：把 plugins/src 下的第一方插件连同 plugin.json 复制到
       输出目录的 plugins/<清单 id>/（PluginPaths.InstallDirectory 的落点）。 -->
  <Import Project="..\plugins\src\StarPie.Plugin.Programs\Package.targets" />
  <Import Project="..\plugins\src\StarPie.Plugin.SampleUi\Package.targets" />

</Project>
