<UserControl x:Class="StarPie.Views.Pages.PluginManagerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="569" d:DesignWidth="780"
             FontFamily="Segoe UI, Microsoft YaHei UI, Arial"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock AutomationProperties.AutomationId="PluginManagerPageHeader"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Text="{DynamicResource PagePlugins}" />
            <TextBlock AutomationProperties.AutomationId="PluginManagerSubheader"
                       Margin="0,4,0,0" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{DynamicResource PluginManagerSubheader}" />
            <!--  准入模式常显：当前进程凭什么允许装载插件。  -->
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{DynamicResource PluginManagerAdmissionMode}" />
                <TextBlock AutomationProperties.AutomationId="PluginManagerAdmissionMode"
                           Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding AdmissionModeText}" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Margin="0,0,12,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                <ItemsControl AutomationProperties.AutomationId="PluginManagerList"
                                  ItemsSource="{Binding Plugins}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="16"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
    
                                        <StackPanel Grid.Column="0">
                                            <TextBlock AutomationProperties.AutomationId="{Binding NameAutomationId}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding DisplayName}" />
                                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                                <TextBlock AutomationProperties.AutomationId="{Binding StatusAutomationId}"
                                                           Margin="0,0,10,0" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="{Binding StatusText}" />
                                                <TextBlock Margin="0,0,10,0" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="{Binding AdmissionText}" />
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="{Binding VersionText}" />
                                            </StackPanel>
                                            <TextBlock Margin="0,4,0,0" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding QuarantineText}"
                                                       Visibility="{Binding HasQuarantine, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock AutomationProperties.AutomationId="{Binding PendingRestartAutomationId}"
                                                       Margin="0,4,0,0" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding PendingRestartText}"
                                                       Visibility="{Binding HasPendingRestart, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
    
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                                    Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Margin="0,0,8,0" Padding="12,4"
                                                    AutomationProperties.AutomationId="{Binding ToggleAutomationId}"
                                                    Command="{Binding ToggleCommand}"
                                                    Content="{Binding ToggleText}"
                                                    Style="{StaticResource ModernButtonStyle}"
                                                    Visibility="{Binding CanToggle, Converter={StaticResource BoolToVis}}" />
                                            <Button Margin="0,0,8,0" Padding="12,4"
                                                    AutomationProperties.AutomationId="{Binding ReloadAutomationId}"
                                                    Command="{Binding ReloadCommand}"
                                                    Content="{Binding ReloadText}"
                                                    Style="{StaticResource ModernButtonStyle}"
                                                    Visibility="{Binding CanReload, Converter={StaticResource BoolToVis}}" />
                                            <Button Margin="0,0,8,0" Padding="12,4"
                                                    AutomationProperties.AutomationId="{Binding UpdateAutomationId}"
                                                    Command="{Binding UpdateCommand}"
                                                    Content="{Binding UpdateText}"
                                                    Style="{StaticResource ModernButtonStyle}"
                                                    Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVis}}" />
                                            <Button Margin="0,0,8,0" Padding="12,4"
                                                    AutomationProperties.AutomationId="{Binding RetryAutomationId}"
                                                    Command="{Binding RetryCommand}"
                                                    Content="{DynamicResource PluginManagerRetry}"
                                                    Style="{StaticResource ModernButtonStyle}"
                                                    Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
                                            <Button Margin="0,0,8,0" Padding="12,4"
                                                    AutomationProperties.AutomationId="{Binding UninstallAutomationId}"
                                                    Command="{Binding UninstallCommand}"
                                                    Content="{DynamicResource PluginManagerUninstall}"
                                                    Style="{StaticResource ModernButtonStyle}"
                                                    Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}" />
                                            <Button Padding="12,4"
                                                    AutomationProperties.AutomationId="{Binding DiagnosticsAutomationId}"
                                                    Command="{Binding DiagnosticsCommand}"
                                                    Content="{DynamicResource PluginManagerDiagnostics}"
                                                    Style="{StaticResource ModernButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                <!--  插件贡献的设置区：无插件区块时该区一并消失（扩展点降级不留空壳）。  -->
                <StackPanel AutomationProperties.AutomationId="PluginSettingsSections"
                            Margin="0,8,0,0"
                            Visibility="{Binding HasPluginSettingsSections, Converter={StaticResource BoolToVis}}">
                    <TextBlock Margin="0,0,0,8" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{DynamicResource PluginSettingsSectionsTitle}" />
                    <ItemsControl ItemsSource="{Binding PluginSettingsSections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="16"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding Title}" />
                                        <ContentControl Margin="0,8,0,0" Content="{Binding ViewModel}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Padding="16"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{DynamicResource PluginManagerDiagnosticsTitle}" />
                    <TextBox AutomationProperties.AutomationId="PluginDiagnosticsText"
                             AcceptsReturn="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             IsReadOnly="True"
                             Text="{Binding DiagnosticsText, Mode=OneWay}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
