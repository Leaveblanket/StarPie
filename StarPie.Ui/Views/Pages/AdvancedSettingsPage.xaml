<UserControl x:Class="StarPie.Views.Pages.AdvancedSettingsPage"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        d:DesignHeight="569" d:DesignWidth="780"
                        FontFamily="Segoe UI, Microsoft YaHei UI, Arial"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        mc:Ignorable="d">

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock AutomationProperties.AutomationId="AdvancedPageHeader" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{DynamicResource AdvancedHeader}" />
                <TextBlock AutomationProperties.AutomationId="AdvancedPageSubheader" Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{DynamicResource AdvancedSubheader}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <!--  卡片 0：界面语言选择  -->
                    <Border Margin="0,0,0,14" Padding="20"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.03" ShadowDepth="1"
                                              Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontSize="14"
                                               Text="🌐" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{DynamicResource LanguageTitle}" />
                                </StackPanel>
                                <TextBlock Margin="0,2,0,0" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{DynamicResource LanguageDesc}" />
                            </StackPanel>
                            <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Height="34"
                                      VerticalAlignment="Center"
                                       SelectedValuePath="Tag"
                                       SelectedValue="{Binding LanguageCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Style="{StaticResource FlatComboBoxStyle}">
                                <ComboBoxItem Content="{DynamicResource LangZhCn}" Tag="zh-CN" />
                                <ComboBoxItem Content="{DynamicResource LangZhTw}" Tag="zh-TW" />
                                <ComboBoxItem Content="{DynamicResource LangEn}" Tag="en" />
                                <ComboBoxItem Content="{DynamicResource LangJa}" Tag="ja" />
                                <ComboBoxItem Content="{DynamicResource LangAuto}" Tag="Auto" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!--  卡片 1：Windows 开机自启  -->
                    <Border Margin="0,0,0,14" Padding="20"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.03" ShadowDepth="1"
                                              Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{DynamicResource StartupTitle}" />
                                <TextBlock Margin="0,2,0,0" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{DynamicResource StartupDesc}" />
                            </StackPanel>
                            <CheckBox x:Name="AutoStartCheckBox" Grid.Column="1"
                                      VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="AutoStartCheckBox"
                                      IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      />
                        </Grid>
                    </Border>

                    <!--  卡片 1b：以管理员身份开机自启（任务计划程序 /rl highest，触发时不弹 UAC）。
                          勾上它会把上面的自启一并打开（提权自启蕴含自启）。  -->
                    <Border Margin="0,0,0,14" Padding="20"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.03" ShadowDepth="1"
                                              Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{DynamicResource AdminAutoStartTitle}" />
                                <TextBlock Margin="0,2,0,0" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{DynamicResource AdminAutoStartDesc}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox x:Name="AdminAutoStartCheckBox" Grid.Column="1"
                                      VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="AdminAutoStartCheckBox"
                                      IsChecked="{Binding AdminAutoStartEnabled, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      />
                            <!--  立即提权：路线 B 的即时触发形态（复用上面那颗任务，不弹 UAC）。
                                  提权态下整块不出现；任务不在时按钮不可点，并把原因写在旁边。  -->
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                                        Margin="0,12,0,0"
                                        Visibility="{Binding ShowRestartElevated, Converter={StaticResource BoolToVis}}">
                                <Button x:Name="AdminRestartNowButton"
                                        HorizontalAlignment="Left"
                                        Height="32" Padding="14,0"
                                        AutomationProperties.AutomationId="AdminRestartNowButton"
                                        IsEnabled="{Binding CanRestartElevated}"
                                        Command="{Binding RestartElevatedNowCommand}"
                                        Content="{DynamicResource AdminRestartNow}"
                                        Style="{StaticResource ModernButtonStyle}" />
                                <TextBlock x:Name="AdminRestartNowHint"
                                           AutomationProperties.AutomationId="AdminRestartNowHint"
                                           Margin="0,6,0,0" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{DynamicResource AdminRestartNowNeedsAutostart}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding ShowRestartElevatedHint, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  卡片 2：配置备份与迁移  -->
                    <Border Padding="20"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.03" ShadowDepth="1"
                                              Color="#000000" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,12" FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{DynamicResource BackupTitle}" />
                            <WrapPanel>
                                <Button Height="34" Margin="0,0,10,0"
                                         Padding="14,0" Command="{Binding ExportConfigCommand}"
                                        Content="{DynamicResource BtnExportConfig}"
                                        Style="{StaticResource ModernButtonStyle}" />
                                <Button Height="34" Padding="14,0"
                                         Command="{Binding ImportConfigCommand}" Content="{DynamicResource BtnImportConfig}"
                                        Style="{StaticResource ModernButtonStyle}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
