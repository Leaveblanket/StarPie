<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:StarPie.Views.Controls">
    <!--  热键录制控件（HotkeyRecorderBox）隐式默认样式：控件随共享 UI 基建去共享化
         （ADR-0022/#94）下沉本模块（Views/Controls/HotkeyRecorderBox.cs，P1.6/#115 随
         M1 归并入 Ui），样式段同驻本集，由 App.xaml 本地单点合并一次；
         模板引用的 ModernControls 几何令牌经 DynamicResource 跨字典运行期解析。  -->
    <Style TargetType="{x:Type controls:HotkeyRecorderBox}">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:HotkeyRecorderBox}">
                    <Border x:Name="PART_Border" Padding="8,2"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  占位/录制提示文案用语言键 {DynamicResource}，状态配色用主题令牌 +
                                  IsRecording 触发器；code-behind 只编排动态热键文本（PART_DisplayText）
                                  与三块文本的可见性。  -->
                            <TextBlock x:Name="PART_PlaceholderText" Grid.Column="0"
                                       VerticalAlignment="Center" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Opacity="0.6"
                                       Text="{TemplateBinding Placeholder}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="Collapsed" />

                            <TextBlock x:Name="PART_HintText" Grid.Column="0"
                                       VerticalAlignment="Center" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Text="{DynamicResource HotkeyRecorderHint}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="Collapsed" />

                            <TextBlock x:Name="PART_DisplayText" Grid.Column="0"
                                       VerticalAlignment="Center" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="Collapsed" />

                            <Button x:Name="PART_ClearButton" Grid.Column="1" Width="16"
                                    Height="16" Margin="4,0,0,0" Padding="0"
                                    VerticalAlignment="Center" Background="Transparent"
                                    BorderThickness="0" Content="✕" Cursor="Hand"
                                    Style="{x:Null}"
                                    FontSize="10"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    ToolTip="{DynamicResource ClearHotkeyTooltip}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsRecording" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Setter TargetName="PART_Border" Property="Background" Value="{DynamicResource NavPageActiveBgBrush}" />
                            <Setter TargetName="PART_DisplayText" Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
