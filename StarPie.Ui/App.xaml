<Application
    x:Class="StarPie.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:StarPie.Views.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Light 主题默认/设计时画刷（本地绝对 pack URI，槽位以 /Themes/ 识别）；
                      运行时由 AppThemePaletteManager 整项替换同源主题槽  -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Light.xaml" />
                <!--  全局控件样式字典：本地合并，窗口/页面不再各自合并  -->
                <ResourceDictionary Source="Views/Styles/ModernControls.xaml" />
                <!--  热键录制控件样式字典：本地合并  -->
                <ResourceDictionary Source="Views/Styles/HotkeyRecorderBox.xaml" />
                <!--  模块页面模板字典：本地合并；宿主外观聚合页模板在 Modules/HostPageTemplates.xaml  -->
                <ResourceDictionary Source="Modules/GesturesPageTemplates.xaml" />
                <ResourceDictionary Source="Modules/ShellPageTemplates.xaml" />
                <ResourceDictionary Source="Modules/HostPageTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <!--  通用共享转换器（宿主本地，自 Core 迁入）：实例由 App 级资源单点持有  -->
            <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
            <converters:StringToGeometryConverter x:Key="StringToGeometryConverter" />
            <converters:IntEqualsConverter x:Key="IntEqualsConverter" />
            <converters:FilePathToImageConverter x:Key="FilePathToImageConverter" />
            <!--  轮盘核图标预览配套转换器：外观聚合页预览用  -->
            <converters:CoreIconGeometryConverter x:Key="CoreIconGeometryConverter" />
            <converters:CoreIconNameConverter x:Key="CoreIconNameConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
