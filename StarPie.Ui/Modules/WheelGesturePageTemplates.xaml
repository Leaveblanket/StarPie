<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:StarPie.Ui.ViewModels.Pages"
                    xmlns:pages="clr-namespace:StarPie.Ui.Views.Pages">

    <!-- 本模块页面模板字典：模块自带 DataTemplate，由宿主经跨程序集 pack URI 每模块静态合并一次。
         页面 View 无参构造、按导航重建、不经容器；页面直承 UserControl、无共享基类，
         本字典只映射本模块两页。 -->
    <DataTemplate DataType="{x:Type vm:BehaviorSettingsViewModel}">
        <pages:TriggerSettingsPage/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProfileListViewModel}">
        <pages:WheelGestureSettingsPage/>
    </DataTemplate>
</ResourceDictionary>
