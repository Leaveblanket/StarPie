<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- B6/#79：M5 壳层与系统集成模块程序集（ADR-0016 决策 1/8/12；首个带 DI 的模块程序集）。
         B10/#83：命名空间统一为 StarPie.* 前缀替换，RootNamespace=StarPie。
         依赖方向：StarPie.Shell → StarPie.Sdk（headless 契约/模型，含 S6 IDialogService）+
         StarPie.Host（宿主内核：S2 配置 / S3 本地化）单向；StarPie.Core 引用只为设计期资源锚
         解析设计期字符串字典的 pack URI（非运行时依赖）；不引用其它业务模块。
         页面/VM 的 DI 注册与导航自报经 ShellModuleRegistrar（RegisterServices + RegisterNavigation）
         下放本程序集，组合根仍唯一 BuildServiceProvider。 -->
    <UseWPF>true</UseWPF>
    <AssemblyName>StarPie.Shell</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- M5 → 宿主内核单向依赖（页面 VM 消费 S2 配置/S3 本地化接缝） -->
    <ProjectReference Include="..\StarPie.Host\StarPie.Host.csproj" />
    <!-- 设计期资源锚的 pack URI 解析目标（设计期字符串字典在 Core） -->
    <ProjectReference Include="..\StarPie.Core\StarPie.Core.csproj" />
    <!-- P1.3/#112：headless 契约/模型随 SDK 收口迁入 StarPie.Sdk（IDialogService、导航目录、
         AppHostDelegates、AppConfig/消息等） -->
    <ProjectReference Include="..\StarPie.Sdk\StarPie.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-0025/#101：VS 设计期资源锚（仅设计期合并，运行时不会自动合并）。 -->
    <Page Update="Properties\DesignTimeResources.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
      <ContainsDesignTimeResources>true</ContainsDesignTimeResources>
    </Page>
  </ItemGroup>

</Project>
