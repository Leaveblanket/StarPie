<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 设计期资源锚（ADR-0025/#101）：VS 设计器按 Properties/DesignTimeResources.xaml
         固定路径识别并仅在设计期合并 Core 的设计期字符串字典（pack URI）；
         运行时不会自动合并，不承载任何运行时可解析资源。 -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/StarPie.Core;component/Services/Localization/DesignTimeStrings.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
