                            <TextBlock x:Name="NavTab3Text" Text="⚙️ 高级与系统" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavTab4" Style="{StaticResource NavTabRadioButtonStyle}" GroupName="SidebarTabs" Tag="4" Checked="NavTab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=RadioButton}, Path=Foreground}" 
                                  Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"/>
                            <TextBlock x:Name="NavTab4Text" Text="📋 关于与更新" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                
                <!-- Version Footer -->
                <StackPanel Grid.Row="2" Margin="0,15,0,5">
                    <Border Background="{DynamicResource NavTabActiveBgBrush}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,4">
                        <TextBlock Text="v1.4.1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                    </Border>
                    <TextBlock Text="© 2026 StarPie" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Right Main Panel -->
        <Grid Grid.Column="1" Margin="25,25,25,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Tab Pages -->
            <Grid Grid.Row="0">
                <!-- ================= PAGE 0: TRIGGERS & SCENES ================= -->
                <Grid x:Name="TriggerSettingsGrid" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock x:Name="TriggerPageHeader" Text="触发与场景隔离设置" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TriggerPageSubheader" Text="在此配置全局鼠标手势的触发灵敏度、全屏游戏自动拦截与排除程序黑名单。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <!-- Card 1: Trigger Sensitivity -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock x:Name="SensitivityTitleText" Text="手势触发灵敏度" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="SensitivityDescText" Text="按住鼠标右键移动超过指定像素距离后呼出手势轮盘。距离越小越灵敏，过小可能造成右键微抖动误触。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,12"/>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="ThresholdSlider" Minimum="10" Maximum="60" Value="25" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="ThresholdSlider_ValueChanged"/>
                                        <TextBlock x:Name="ThresholdValueLabel" Grid.Column="1" Text="25" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- Card 1.5: Outer Escape Cancel Setting Card -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14" SnapsToDevicePixels="True" UseLayoutRounding="True" RenderOptions.ClearTypeHint="Enabled">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock x:Name="OuterEscapeTitleText" Text="顺势外甩脱离取消 (Outer Escape Cancel)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="OuterEscapeDescText" Text="手势划出后若想放弃，无需拉回中心，直接顺势向外快速划出即可安全取消，0 误触。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,10" TextWrapping="Wrap"/>
                                    <CheckBox x:Name="EnableOuterEscapeCheckBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,4,0,4" Checked="OuterEscapeCheckBox_Checked" Unchecked="OuterEscapeCheckBox_Unchecked">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock x:Name="OuterEscapeCheckboxTitleText" Text="启用向外顺势甩出取消手势 (推荐开启)" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="OuterEscapeCheckboxDescText" Text="超过轮盘外圈范围后立即解除高亮，松开右键 0 误触安全放弃。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>

                                    <!-- Escape Distance Slider (Shown when enabled) -->
                                    <StackPanel x:Name="OuterEscapeDistancePanel" Margin="0,10,0,0">
                                        <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock x:Name="OuterEscapeDistanceTitleText" Text="外甩取消距离灵敏度 (Escape Distance):" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock x:Name="OuterEscapeDistanceDescText" Text="设定光标划出距离中心多远时触发安全取消。数值越小越灵敏（更易甩出取消），数值越大越沉稳（需甩得更远）。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider x:Name="OuterEscapeDistanceSlider" Minimum="140" Maximum="320" Value="190" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OuterEscapeDistanceSlider_ValueChanged"/>
                                                    <TextBlock x:Name="OuterEscapeDistanceLabel" Grid.Column="1" Text="190 px" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Scene Isolation & Bypass -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock x:Name="SceneIsolationTitleText" Text="场景隔离与防误触" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="SceneIsolationDescText" Text="当处于特定场景或配合修饰键操作时，自动绕过轮盘拦截，放行原生右键事件。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,12"/>
                                    
                                    <CheckBox x:Name="DisableOnFullScreenCheckBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,4,0,14" Checked="DisableOnFullScreenCheckBox_Changed" Unchecked="DisableOnFullScreenCheckBox_Changed">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock x:Name="FullScreenOptionTitleText" Text="全屏游戏/独占应用自动禁用手势" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="FullScreenOptionDescText" Text="自动检测当前前台窗口是否处于全屏独占状态，避免游戏瞄准等右键操作被拦截。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>

                                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,4,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="ModifierPassTitleText" Text="快捷键旁路穿透 (按住以下修饰键拖拽时不触发手势):" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                            <WrapPanel>
                                                <CheckBox x:Name="CtrlModifierCheckBox" Content="按住 Ctrl 键时旁路" Margin="0,0,20,8" Checked="ModifierCheckBox_Changed" Unchecked="ModifierCheckBox_Changed"/>
                                                <CheckBox x:Name="ShiftModifierCheckBox" Content="按住 Shift 键时旁路" Margin="0,0,20,8" Checked="ModifierCheckBox_Changed" Unchecked="ModifierCheckBox_Changed"/>
                                                <CheckBox x:Name="AltModifierCheckBox" Content="按住 Alt 键时旁路" Margin="0,0,20,8" Checked="ModifierCheckBox_Changed" Unchecked="ModifierCheckBox_Changed"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Process Exclusion Blacklist -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock x:Name="BlacklistTitleText" Text="进程排除黑名单" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="BlacklistDescText" Text="在排除名单中的应用程序（如远程桌面、画图、3D建模软件）中，完全放行鼠标右键。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,12"/>
                                    
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewBlacklistProcessTextBox" Height="34" Margin="0,0,8,0"
                                                 FontSize="12" VerticalContentAlignment="Center"
                                                 ToolTip="输入进程名称 (如 solidworks.exe) 或直接点击右侧选择应用..."
                                                 KeyDown="NewBlacklistProcessTextBox_KeyDown"/>
                                        <Button x:Name="BrowseBlacklistButton" Grid.Column="1" Content="🔍 选择应用..." 
                                                Style="{StaticResource ModernButtonStyle}" Height="34" Padding="14,0" Margin="0,0,8,0" 
                                                Click="BrowseBlacklistButton_Click" ToolTip="从已安装软件列表中快速选择要排除的程序"/>
                                        <Button x:Name="AddBlacklistButton" Grid.Column="2" Content="➕ 添加进程" 
                                                Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="16,0" 
                                                Click="AddBlacklistButton_Click" ToolTip="将输入框中的进程名称加入排除黑名单"/>
                                    </Grid>

                                    <ListBox x:Name="BlacklistListBox" Height="110" Margin="0,0,0,8" KeyDown="BlacklistListBox_KeyDown"/>
                                    <Button x:Name="DeleteBlacklistButton" Content="🗑️ 移除选中的进程" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Right" Height="30" Padding="12,0" Click="DeleteBlacklistButton_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ================= PAGE 1: APPEARANCE & LIVE CANVAS ================= -->
                <Grid x:Name="AppearanceSettingsGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock x:Name="AppearancePageHeader" Text="外观、主题与实时画布" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="AppearancePageSubheader" Text="微调轮盘视觉风格、几何形态、光学切缝与配色方案，右侧支持 60FPS 所见即所得交互测试。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <!-- Split Pane: Left Config (1.15*) + Right Live Preview (1*) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left Config Controls -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,14,0">
                            <StackPanel Margin="0,0,6,0">
                                <!-- Card 0: App Interface Theme (软件界面主题风格) -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="软件控制台界面主题 (App Theme)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="定制 StarPie 控制台整体界面的视觉色彩风格，支持跟随 Windows 系统深浅色切换。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                        
                                        <ComboBox x:Name="AppThemeComboBox" Style="{StaticResource FlatComboBoxStyle}" Height="34" SelectionChanged="AppThemeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="🌓 跟随系统 (System Auto)" Tag="System" IsSelected="True"/>
                                            <ComboBoxItem Content="☀️ 极简纯白 (Modern Light)" Tag="Light"/>
                                            <ComboBoxItem Content="🌙 极夜曜黑 (Obsidian Dark)" Tag="Dark"/>
                                            <ComboBoxItem Content="🌌 午夜深蓝 (Midnight Navy)" Tag="MidnightNavy"/>
                                            <ComboBoxItem Content="🔮 暗夜紫罗兰 (Royal Violet)" Tag="RoyalViolet"/>
                                            <ComboBoxItem Content="⚙️ 钛金深灰 (Titanium Gray)" Tag="TitaniumGray"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <!-- Theme & Style Preset -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="轮盘视觉风格与色彩" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                        
                                        <TextBlock Text="主题风格 (UiStyle):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="UiStyleComboBox" Style="{StaticResource FlatComboBoxStyle}" Height="34" Margin="0,0,0,10" SelectionChanged="UiStyleComboBox_SelectionChanged">
                                            <ComboBoxItem Content="经典圆环 (Classic Ring)" Tag="ClassicRing" IsSelected="True"/>
                                            <ComboBoxItem Content="极简扇区 (Clean Sectors)" Tag="CleanSectors"/>
                                            <ComboBoxItem Content="液态毛玻璃 (Glassmorphism)" Tag="Glassmorphism"/>
                                            
                                        </ComboBox>

                                        <TextBlock Text="轮盘配色方案 (Wheel Theme):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="ThemeComboBox" Style="{StaticResource FlatComboBoxStyle}" Height="34" SelectionChanged="ThemeComboBox_SelectionChanged">
                                                <ComboBoxItem Content="跟随系统 (System Auto)" Tag="System"/>
                                                <ComboBoxItem Content="深色模式 (Dark)" Tag="Dark"/>
                                                <ComboBoxItem Content="浅色模式 (Light)" Tag="Light"/>
                                                <ComboBoxItem Content="抹茶森林 (Matcha Forest)" Tag="MatchaForest"/>
                                                <ComboBoxItem Content="冰川透蓝 (Glacial Ice)" Tag="GlacialIce"/>
                                                <ComboBoxItem Content="莫兰迪柔灰 (Morandi Muted)" Tag="MorandiMuted"/>
                                            </ComboBox>
                                            <Button x:Name="RenameCustomColorPresetButton" Grid.Column="1" Content="✏️ 重命名预设" Style="{StaticResource ModernButtonStyle}" Height="34" Margin="8,0,0,0" Padding="12,0" Visibility="Collapsed" Click="RenameCustomColorPresetButton_Click" ToolTip="重命名当前选中的自定义配色方案预设"/>
                                        </Grid>

                                                                        <!-- Card 1.5: Custom Advanced Colors (Collapsible) -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                    </Border.Effect>
                                    <Expander x:Name="CustomColorExpander" IsExpanded="False" Background="Transparent" BorderThickness="0">
                                        <Expander.Header>
                                            <StackPanel Margin="0,2,0,2">
                                                <TextBlock x:Name="CustomColorsExpanderTitleText" Text="🎨 自定义高级配色与色彩微调" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock x:Name="CustomColorsExpanderDescText" Text="展开后可精准微调扇区底色、高亮光晕、边框线条、文字与光弧等各项色彩。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel x:Name="CustomColorsPanel" Margin="0,12,0,4">
                                            <TextBlock Text="自定义十六进制色彩 (色盘调色 / 屏幕吸色):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                            
                                            <!-- Sector Normal Color -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="68"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
