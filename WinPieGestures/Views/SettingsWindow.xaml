                                            <TextBlock x:Name="SectorFontSizeLabel" Grid.Column="1" Text="10.5 px" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
