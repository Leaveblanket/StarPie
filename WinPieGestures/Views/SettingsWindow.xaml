                                        <Path Stroke="{DynamicResource PreviewGridLineBrush}" StrokeThickness="0.5" Data="M0,150 L300,150 M150,0 L150,300" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        
                                        <!-- Interactive Live Canvas -->
                                        <Canvas x:Name="LiveWheelPreviewCanvas" Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                MouseMove="LiveWheelPreviewCanvas_MouseMove" MouseLeave="LiveWheelPreviewCanvas_MouseLeave"/>
                                    </Grid>
                                </Border>

                                <!-- Quick Reset Button -->
                                <Button x:Name="ResetDimensionsButton" Grid.Row="2" Content="一键重置为推荐几何尺寸" Style="{StaticResource ModernButtonStyle}" Height="32" Click="ResetDimensionsButton_Click" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ================= PAGE 2: MAPPINGS & ACTIONS ================= -->
                <Grid x:Name="MappingsSettingsGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock x:Name="GesturesPageHeader" Text="手势方向与动作映射" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="GesturesPageSubheader" Text="支持针对不同前台应用程序设置专属的多向手势轮盘、按键动作与矢量图标。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <!-- Profile Selection Card -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="ProfileCardTitleText" Text="当前配置方案 (Profile)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="ProfileCardDescText" Text="选择或新建针对特定程序（如 Chrome、VS Code）或特定工作流的轮盘配置方案（支持双击重命名）。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,10"/>
                                        <ListBox x:Name="ProfilesListBox" Height="100" SelectionChanged="ProfilesListBox_SelectionChanged" MouseDoubleClick="ProfilesListBox_MouseDoubleClick" DisplayMemberPath="ProcessName"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                                        <Button x:Name="AddProfileButton" Content="➕ 新增专属程序配置" Style="{StaticResource PrimaryButtonStyle}" Height="30" Margin="0,0,0,5" Click="AddProfileButton_Click" ToolTip="从已安装软件或开始菜单中选择程序创建专属配置"/>
                                        <Button x:Name="AddCustomProfileButton" Content="➕ 新建自定义配置" Style="{StaticResource ModernButtonStyle}" Height="30" Margin="0,0,0,5" Click="AddCustomProfileButton_Click" ToolTip="自定义命名创建新的轮盘配置方案"/>
                                        <Button x:Name="RenameProfileButton" Content="✏️ 重命名当前配置" Style="{StaticResource ModernButtonStyle}" Height="30" Margin="0,0,0,5" Click="RenameProfileButton_Click" ToolTip="重命名选中的配置方案"/>
                                        <Button x:Name="DeleteProfileButton" Content="🗑️ 删除当前配置" Style="{StaticResource ModernButtonStyle}" Height="30" Click="DeleteProfileButton_Click" ToolTip="删除选中的配置方案"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Sector Count Card -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock x:Name="SectorCountTitleText" Text="扇区方位数量 (Sector Count)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="SectorCountDescText" Text="切换手势轮盘的切分数量。4 键最快最不易误触，8 键为标准全能方位，12 键适合功能密集场景。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SectorCount4Radio" GroupName="SectorCountGroup" Content="4 键十字方位" Margin="0,0,24,0" Checked="SectorCountRadio_Checked"/>
                                        <RadioButton x:Name="SectorCount8Radio" GroupName="SectorCountGroup" Content="8 键全向方位 (推荐)" Margin="0,0,24,0" IsChecked="True" Checked="SectorCountRadio_Checked"/>
                                        <RadioButton x:Name="SectorCount12Radio" GroupName="SectorCountGroup" Content="12 键钟表方位" Checked="SectorCountRadio_Checked"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Sector Actions Mapping List -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock x:Name="SectorActionListTitleText" Text="扇区动作映射列表" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="SectorActionListDescText" Text="为每个方位指定触发动作与图标。支持热键组合（如 Ctrl+C）、启动本地程序与系统级操作。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,14"/>
                                    
                                    <ItemsControl x:Name="SlotsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="95"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <!-- Col 0: Direction -->
                                                        <TextBlock Text="{Binding DirectionLabel}" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" FontSize="12"/>
                                                        
                                                        <!-- Col 1: Icon Selector Button -->
                                                        <Button Grid.Column="1" Style="{StaticResource ModernButtonStyle}" Height="30" Padding="6,0" Margin="0,0,8,0" Click="PickIcon_Click" ToolTip="点击选取矢量图标">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentPrimaryBrush}" Margin="0,0,4,0"
                                                                      Data="{Binding VectorIconData}" Visibility="{Binding HasVectorIcon, Converter={StaticResource BoolToVis}}"/>
                                                                <TextBlock Text="{Binding IconDisplayText}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="52"/>
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Col 2: Name Input -->
                                                        <TextBox Grid.Column="2" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Height="30" FontSize="12" VerticalContentAlignment="Center"/>
                                                        
                                                        <!-- Col 3: Type Selector (Dynamic I18n) -->
                                                        <ComboBox Grid.Column="3" 
                                                                  ItemsSource="{Binding ActionTypes}"
                                                                  SelectedValue="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                  SelectedValuePath="Tag" 
                                                                  DisplayMemberPath="DisplayText"
                                                                  Style="{StaticResource FlatComboBoxStyle}" 
                                                                  Height="30" Margin="0,0,8,0" FontSize="12"/>
                                                        
                                                        <!-- Col 4: Parameter Inputs -->
                                                        <Grid Grid.Column="4" Margin="0,0,8,0">
                                                            <!-- 1. Hotkey Interactive Recorder Box -->
                                                            <local:HotkeyRecorderBox HotkeyText="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                     Visibility="{Binding IsHotkeyType, Converter={StaticResource BoolToVis}}" Height="30" FontSize="12"/>
                                                            
                                                            <!-- 2. Program Launch -->
                                                            <Grid Visibility="{Binding IsLaunchType, Converter={StaticResource BoolToVis}}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                         IsReadOnly="True" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Height="30" Margin="0,0,4,0" FontSize="11" VerticalContentAlignment="Center" ToolTip="选择的应用程序路径"/>
                                                                <Button Grid.Column="1" Width="34" Style="{StaticResource ModernButtonStyle}" Click="Browse_Click" Height="30" ToolTip="选择应用程序或快捷方式...">
                                                                    <TextBlock Text="📁" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Button>
                                                            </Grid>

                                                            <!-- 3. Open Folder -->
                                                            <Grid Visibility="{Binding IsFolderType, Converter={StaticResource BoolToVis}}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                         Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Height="30" Margin="0,0,4,0" FontSize="11" VerticalContentAlignment="Center" ToolTip="选择的本地文件夹路径"/>
                                                                <Button Grid.Column="1" Width="34" Style="{StaticResource ModernButtonStyle}" Click="BrowseFolder_Click" Height="30" ToolTip="选择本地文件夹...">
                                                                    <TextBlock Text="📂" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Button>
                                                            </Grid>
                                                            
                                                            <!-- 4. System Preset -->
                                                            <ComboBox SelectedValue="{Binding SelectedSystemPreset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      SelectedValuePath="Key" DisplayMemberPath="Value"
                                                                      Style="{StaticResource FlatComboBoxStyle}"
                                                                      ItemsSource="{Binding Source={x:Static local:SlotViewModel.SystemPresets}}"
                                                                      Visibility="{Binding IsSystemType, Converter={StaticResource BoolToVis}}" Height="30" FontSize="12"/>
                                                        </Grid>
                                                        
                                                        <!-- Col 5: Launch Arguments -->
                                                        <TextBox Grid.Column="5" Text="{Binding Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                 IsEnabled="{Binding IsLaunchType}" Margin="0,0,8,0" Height="30" FontSize="11" ToolTip="启动参数 (如命令行参数或URL)" VerticalContentAlignment="Center"/>
                                                        
                                                        <!-- Col 6: Test Button -->
                                                        <Button Grid.Column="6" Content="{Binding TestButtonText}" Style="{StaticResource ModernButtonStyle}" Height="30" Padding="12,0" Click="Test_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ================= PAGE 3: SYSTEM & ADVANCED ================= -->
                <Grid x:Name="SystemSettingsGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock x:Name="AdvancedPageHeader" Text="高级系统与运维备份" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="AdvancedPageSubheader" Text="管理界面语言、Windows 开机自启、管理员提权与配置文件的导入/导出备份。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <!-- Card 0: Display Language Selection -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="240"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🌐" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="LanguageTitleText" Text="界面语言 (Display Language)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="LanguageDescText" Text="选择软件控制台与轮盘界面的显示语言，即时生效并持久保存。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Style="{StaticResource FlatComboBoxStyle}" Height="34" VerticalAlignment="Center" SelectionChanged="LanguageComboBox_SelectionChanged">
                                        <ComboBoxItem Tag="zh-CN" Content="🇨🇳 简体中文 (Simplified Chinese)"/>
                                        <ComboBoxItem Tag="zh-TW" Content="🇭🇰/🇹🇼 繁體中文 (Traditional Chinese)"/>
                                        <ComboBoxItem Tag="en" Content="🇺🇸 English (US/UK)"/>
                                        <ComboBoxItem Tag="ja" Content="🇯🇵 日本語 (Japanese)"/>
                                        <ComboBoxItem Tag="Auto" Content="🖥️ 跟随系统 (System Default)"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Card 1: Windows Auto-Start -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="StartupTitleText" Text="Windows 开机自启动" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="StartupDescText" Text="登录 Windows 系统时自动在后台静默启动 StarPie，无需手动打开。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoStartCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Checked="AutoStartCheckBox_Changed" Unchecked="AutoStartCheckBox_Changed"/>
                                </Grid>
                            </Border>

                            <!-- Card 2: UAC Privilege Elevation -->
                            <Border x:Name="UacWarningCard" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🛡️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ElevateTitleText" Text="以管理员权限运行 (UAC Elevation)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ElevateDescText" Text="当前以普通用户权限运行。若需在任务管理器、注册表或管理员权限程序中响应轮盘手势，建议提升为管理员权限。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="ElevateButton" Grid.Column="1" Content="提升权限" Style="{StaticResource ModernButtonStyle}" Height="32" Padding="14,0" Click="ElevatePrivileges_Click" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Card 3: Memory Optimization -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🚀" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="MemoryOptTitleText" Text="极致轻量内存管理 (Memory Optimization)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="MemoryOptDescText" Text="已开启工作集压缩与动态内存优化，StarPie 常驻后台内存维持在 15~25MB。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="TrimMemoryButton" Grid.Column="1" Content="立即压缩内存" Style="{StaticResource ModernButtonStyle}" Height="32" Padding="14,0" Click="TrimMemoryButton_Click" VerticalAlignment="Center" ToolTip="立即清理未引用的工作集物理内存"/>
                                </Grid>
                            </Border>

                            <!-- Card 4: Config Backup & Migration -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock x:Name="BackupTitleText" Text="配置导出与导入 (Backup &amp; Migration)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    <WrapPanel>
                                        <Button x:Name="ExportConfigButton" Content="导出当前配置为 JSON..." Style="{StaticResource ModernButtonStyle}" Height="34" Padding="14,0" Margin="0,0,10,0" Click="ExportConfigButton_Click"/>
                                        <Button x:Name="ImportConfigButton" Content="从外部 JSON 文件导入..." Style="{StaticResource ModernButtonStyle}" Height="34" Padding="14,0" Click="ImportConfigButton_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- TAB 4: About & Updates (关于与更新) -->
                <Grid x:Name="AboutSettingsGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="关于与更新日志" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="StarPie 现代鼠标轮盘笔势工具版本信息与完整演进历程。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <!-- Card 1: App Info -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" Background="Transparent" CornerRadius="10" VerticalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#000000" Opacity="0.16"/>
                                        </Border.Effect>
                                        <Image Source="logo.png" Width="48" Height="48" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="StarPie" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Border Background="{DynamicResource NavTabActiveBgBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="v1.4.1" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="11"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="高质感、极速现代 Windows 鼠标轮盘笔势工具" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="OpenChangelogButton" Grid.Column="2" Content="查看完整 CHANGELOG" Style="{StaticResource ModernButtonStyle}" VerticalAlignment="Center" Height="34" Click="OpenChangelogButton_Click"/>
                                 </Grid>
                            </Border>

                                                                                                                <!-- Card 2: v1.4.1 Highlights -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14" SnapsToDevicePixels="True" UseLayoutRounding="True" RenderOptions.ClearTypeHint="Enabled">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="v1.4.1 顺势外甩脱离取消 &amp; 防多开单实例 &amp; ClearType 字体锐化 &amp; 多维重命名" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                    <TextBlock Text="• 🚀 新增【顺势外甩脱离取消】机制，超距向外甩出光标即可秒级安全取消，无需折返中心；" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="• 🛡️ 引入全局单实例 Mutex 互斥锁，彻底杜绝程序重复多开与多托盘图标驻留；" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="• 🔤 全面重构 WPF ClearType 亚像素抗锯齿与物理像素排版，彻底解决折叠面板文字发虚模糊；" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="• ✏️ 为自定义配色预设与配置方案增加一键【重命名】按钮与快捷编辑入口。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: v1.4.0 Highlights -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
