                                <!-- Highlight Glow & Luminous Halo Controls (高亮边缘光晕与发光特效) -->
                                        <TextBlock Text="高亮边缘光晕模式 (Highlight Glow):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4"/>
