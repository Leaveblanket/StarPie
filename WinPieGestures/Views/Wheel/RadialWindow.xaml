<Window x:Class="WinPieGestures.Views.Wheel.RadialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RadialWindow"
        Height="360" Width="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    
    <Window.Resources>
        <!-- Premium Radial Shadow -->
        <DropShadowEffect x:Key="RadialShadow" Color="#000000" BlurRadius="28" ShadowDepth="2" Opacity="0.45"/>
        <DropShadowEffect x:Key="TextShadow" Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.8"/>
    </Window.Resources>
    
    <Grid Name="MainGrid" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WindowScale" ScaleX="0.5" ScaleY="0.5"/>
                <SkewTransform/>
                <RotateTransform/>
                <TranslateTransform/>
            </TransformGroup>
        </Grid.RenderTransform>
        
        <!-- Outer Glowing Ring Border -->
        <Ellipse Name="OuterEllipse" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeThickness="1.5">
            <Ellipse.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#40FFFFFF" Offset="0"/>
                    <GradientStop Color="#10FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Ellipse.Stroke>
        </Ellipse>

        <!-- Main Canvas where slices and labels are drawn -->
        <Canvas Name="WheelCanvas" Width="340" Height="340" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource RadialShadow}">
            <!-- Center Glassmorphism Core -->
            <Grid Name="CoreGrid" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="CoreScale" ScaleX="1.0" ScaleY="1.0"/>
                </Grid.RenderTransform>

                <Ellipse Name="CoreEllipse" Fill="#E0111115" Stroke="#30FFFFFF" StrokeThickness="1.2"/>
                
                <!-- Inner soft radial glow -->
                <Ellipse Margin="2">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.2" GradientOrigin="0.5,0.2" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#20FFFFFF" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                
                <StackPanel Name="CoreTextPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5">
                    <!-- Icon or process label -->
                    <TextBlock Name="CoreTitle" Text="WinPie" 
                               Foreground="#D0FFFFFF" FontSize="11" FontWeight="Bold" 
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Name="CoreSubtitle" Text="RMB Drag" 
                               Foreground="#80FFFFFF" FontSize="8" 
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
                
                <!-- Modern Clean Exit Icon -->
                <Path Name="CoreExitIcon" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Width="16" Height="16"
                      Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                
                <!-- Center Core Custom Local Image (Rounded) -->
                <Image Name="CoreCustomImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
        </Canvas>
    </Grid>
</Window>
