<pages:SettingsPageBase x:Class="WinPieGestures.Views.Pages.AdvancedSettingsPage"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:pages="clr-namespace:WinPieGestures.Views.Pages"
                        d:DesignHeight="600" d:DesignWidth="760"
                        FontFamily="Segoe UI, Microsoft YaHei UI, Arial"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        mc:Ignorable="d">

    <Grid d:Background="Yellow">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock AutomationProperties.AutomationId="AdvancedPageHeader" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{DynamicResource AdvancedHeader}" />
                <TextBlock AutomationProperties.AutomationId="AdvancedPageSubheader" Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{DynamicResource AdvancedSubheader}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <!--  Card 0: Display Language Selection  -->
                    <Border Margin="0,0,0,14" Padding="20"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.03" ShadowDepth="1"
                                              Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontSize="14"
                                               Text="🌐" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{DynamicResource LanguageTitle}" />
                                </StackPanel>
                                <TextBlock Margin="0,2,0,0" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{DynamicResource LanguageDesc}" />
                            </StackPanel>
                            <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Height="34"
                                      VerticalAlignment="Center"
                                       SelectedValuePath="Tag"
                                       SelectedValue="{Binding LanguageCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Style="{StaticResource FlatComboBoxStyle}">
                                <ComboBoxItem Content="{DynamicResource LangZhCn}" Tag="zh-CN" />
                                <ComboBoxItem Content="{DynamicResource LangZhTw}" Tag="zh-TW" />
                                <ComboBoxItem Content="{DynamicResource LangEn}" Tag="en" />
                                <ComboBoxItem Content="{DynamicResource LangJa}" Tag="ja" />
                                <ComboBoxItem Content="{DynamicResource LangAuto}" Tag="Auto" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!--  Card 1: Windows Auto-Start  -->
                    <Border Margin="0,0,0,14" Padding="20"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.03" ShadowDepth="1"
                                              Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{DynamicResource StartupTitle}" />
                                <TextBlock Margin="0,2,0,0" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{DynamicResource StartupDesc}" />
                            </StackPanel>
                            <CheckBox x:Name="AutoStartCheckBox" Grid.Column="1"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      />
                        </Grid>
                    </Border>

                    <!--  Card 2: UAC Privilege Elevation  -->
            <Border x:Name="UacWarningCard" Margin="0,0,0,14" Padding="20" Visibility="{Binding ShowUacWarning, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.03" ShadowDepth="1"
                                              Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontSize="14"
                                               Text="🛡️" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{DynamicResource ElevateTitle}" />
                                </StackPanel>
                                <TextBlock Margin="0,2,0,0" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{DynamicResource ElevateDesc}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Height="32"
                                    Padding="14,0" VerticalAlignment="Center"
                                    Command="{Binding ElevateCommand}" Content="{DynamicResource BtnElevate}"
                                    Style="{StaticResource ModernButtonStyle}" />
                        </Grid>
                    </Border>

                    <!--  Card 3: Memory Optimization  -->
                    <Border Margin="0,0,0,14" Padding="20"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.03" ShadowDepth="1"
                                              Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontSize="14"
                                               Text="🚀" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{DynamicResource MemoryTitle}" />
                                </StackPanel>
                                <TextBlock Margin="0,2,0,0" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{DynamicResource MemoryDesc}" />
                            </StackPanel>
                            <Button Grid.Column="1" Height="32"
                                    Padding="14,0" VerticalAlignment="Center"
                                    Command="{Binding TrimMemoryCommand}" Content="{DynamicResource BtnTrimMemory}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    ToolTip="{DynamicResource TrimMemoryTooltip}" />
                        </Grid>
                    </Border>

                    <!--  Card 4: Config Backup & Migration  -->
                    <Border Padding="20"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.03" ShadowDepth="1"
                                              Color="#000000" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,12" FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{DynamicResource BackupTitle}" />
                            <WrapPanel>
                                <Button Height="34" Margin="0,0,10,0"
                                         Padding="14,0" Command="{Binding ExportConfigCommand}"
                                        Content="{DynamicResource BtnExportConfig}"
                                        Style="{StaticResource ModernButtonStyle}" />
                                <Button Height="34" Padding="14,0"
                                         Command="{Binding ImportConfigCommand}" Content="{DynamicResource BtnImportConfig}"
                                        Style="{StaticResource ModernButtonStyle}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</pages:SettingsPageBase>
