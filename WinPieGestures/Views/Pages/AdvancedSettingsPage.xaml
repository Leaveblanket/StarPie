<pages:SettingsPageBase x:Class="WinPieGestures.Views.Pages.AdvancedSettingsPage"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:pages="clr-namespace:WinPieGestures.Views.Pages"
                        d:DesignHeight="600" d:DesignWidth="760"
                        FontFamily="Segoe UI, Microsoft YaHei UI, Arial"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        RenderOptions.ClearTypeHint="Enabled"
                        SnapsToDevicePixels="True"
                        TextOptions.TextFormattingMode="Display"
                        TextOptions.TextRenderingMode="ClearType"
                        UseLayoutRounding="True" mc:Ignorable="d">

    <pages:SettingsPageBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  页面解析期(未挂入主框架树)即需解析 StaticResource:自合并共享样式字典  -->
                <ResourceDictionary Source="../Styles/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:SettingsPageBase.Resources>


    <Grid d:Background="Yellow">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="AdvancedPageHeader" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="高级系统与运维备份" />
                <TextBlock x:Name="AdvancedPageSubheader" Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="管理界面语言、Windows 开机自启、管理员提权与配置文件的导入/导出备份。" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <!--  Card 0: Display Language Selection  -->
                    <Border Margin="0,0,0,14" Padding="20"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.03" ShadowDepth="1"
                                              Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontSize="14"
                                               Text="🌐" />
                                    <TextBlock x:Name="LanguageTitleText" VerticalAlignment="Center"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="界面语言 (Display Language)" />
                                </StackPanel>
                                <TextBlock x:Name="LanguageDescText" Margin="0,2,0,0" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="选择软件控制台与轮盘界面的显示语言，即时生效并持久保存。" />
                            </StackPanel>
                            <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Height="34"
                                      VerticalAlignment="Center"
                                       SelectedValuePath="Tag"
                                       SelectedValue="{Binding LanguageCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Style="{StaticResource FlatComboBoxStyle}">
                                <ComboBoxItem Content="🇨🇳 简体中文 (Simplified Chinese)" Tag="zh-CN" />
                                <ComboBoxItem Content="🇭🇰/🇹🇼 繁體中文 (Traditional Chinese)" Tag="zh-TW" />
                                <ComboBoxItem Content="🇺🇸 English (US/UK)" Tag="en" />
                                <ComboBoxItem Content="🇯🇵 日本語 (Japanese)" Tag="ja" />
                                <ComboBoxItem Content="🖥️ 跟随系统 (System Default)" Tag="Auto" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!--  Card 1: Windows Auto-Start  -->
                    <Border Margin="0,0,0,14" Padding="20"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.03" ShadowDepth="1"
                                              Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="StartupTitleText" FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="Windows 开机自启动" />
                                <TextBlock x:Name="StartupDescText" Margin="0,2,0,0" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="登录 Windows 系统时自动在后台静默启动 StarPie，无需手动打开。" />
                            </StackPanel>
                            <CheckBox x:Name="AutoStartCheckBox" Grid.Column="1"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      />
                        </Grid>
                    </Border>

                    <!--  Card 2: UAC Privilege Elevation  -->
            <Border x:Name="UacWarningCard" Margin="0,0,0,14" Padding="20" Visibility="{Binding ShowUacWarning, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.03" ShadowDepth="1"
                                              Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontSize="14"
                                               Text="🛡️" />
                                    <TextBlock x:Name="ElevateTitleText" VerticalAlignment="Center"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="以管理员权限运行 (UAC Elevation)" />
                                </StackPanel>
                                <TextBlock x:Name="ElevateDescText" Margin="0,2,0,0" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="当前以普通用户权限运行。若需在任务管理器、注册表或管理员权限程序中响应轮盘手势，建议提升为管理员权限。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="ElevateButton" Grid.Column="1" Height="32"
                                    Padding="14,0" VerticalAlignment="Center"
                                    Command="{Binding ElevateCommand}" Content="提升权限"
                                    Style="{StaticResource ModernButtonStyle}" />
                        </Grid>
                    </Border>

                    <!--  Card 3: Memory Optimization  -->
                    <Border Margin="0,0,0,14" Padding="20"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.03" ShadowDepth="1"
                                              Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontSize="14"
                                               Text="🚀" />
                                    <TextBlock x:Name="MemoryOptTitleText" VerticalAlignment="Center"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="极致轻量内存管理 (Memory Optimization)" />
                                </StackPanel>
                                <TextBlock x:Name="MemoryOptDescText" Margin="0,2,0,0" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="已开启工作集压缩与动态内存优化，StarPie 常驻后台内存维持在 15~25MB。" />
                            </StackPanel>
                            <Button x:Name="TrimMemoryButton" Grid.Column="1" Height="32"
                                    Padding="14,0" VerticalAlignment="Center"
                                    Command="{Binding TrimMemoryCommand}" Content="立即压缩内存"
                                    Style="{StaticResource ModernButtonStyle}"
                                    ToolTip="立即清理未引用的工作集物理内存" />
                        </Grid>
                    </Border>

                    <!--  Card 4: Config Backup & Migration  -->
                    <Border Padding="20"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.03" ShadowDepth="1"
                                              Color="#000000" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="BackupTitleText" Margin="0,0,0,12" FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="配置导出与导入 (Backup &amp; Migration)" />
                            <WrapPanel>
                                <Button x:Name="ExportConfigButton" Height="34" Margin="0,0,10,0"
                                         Padding="14,0" Command="{Binding ExportConfigCommand}"
                                        Content="导出当前配置为 JSON..."
                                        Style="{StaticResource ModernButtonStyle}" />
                                <Button x:Name="ImportConfigButton" Height="34" Padding="14,0"
                                         Command="{Binding ImportConfigCommand}" Content="从外部 JSON 文件导入..."
                                        Style="{StaticResource ModernButtonStyle}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</pages:SettingsPageBase>
