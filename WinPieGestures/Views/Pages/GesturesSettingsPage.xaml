<pages:SettingsPageBase x:Class="WinPieGestures.Views.Pages.GesturesSettingsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:WinPieGestures.Views.Controls"
        xmlns:pages="clr-namespace:WinPieGestures.Views.Pages"
        xmlns:vm="clr-namespace:WinPieGestures.ViewModels.Gestures"
        mc:Ignorable="d"
        d:DesignHeight="600" d:DesignWidth="760"
        FontFamily="Segoe UI, Microsoft YaHei UI, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock AutomationProperties.AutomationId="GesturesPageHeader" Text="{DynamicResource GesturesHeader}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock AutomationProperties.AutomationId="GesturesPageSubheader" Text="{DynamicResource GesturesSubheader}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,10,0">
                    <!-- Profile Selection Card -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ProfileCardTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource ProfileCardDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,10"/>
                                <ListBox x:Name="ProfilesListBox" Height="100" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" DisplayMemberPath="ProcessName"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                                <Button AutomationProperties.AutomationId="AddProfileButton" Content="{DynamicResource BtnAddAppProfile}" Style="{StaticResource PrimaryButtonStyle}" Height="30" Margin="0,0,0,5" Command="{Binding AddProfileFromPickerCommand}" ToolTip="{DynamicResource AddProfileTooltip}"/>
                                <Button AutomationProperties.AutomationId="AddCustomProfileButton" Content="{DynamicResource BtnAddCustomProfile}" Style="{StaticResource ModernButtonStyle}" Height="30" Margin="0,0,0,5" Command="{Binding AddCustomProfileFromDialogCommand}" ToolTip="{DynamicResource AddCustomProfileTooltip}"/>
                                <Button AutomationProperties.AutomationId="RenameProfileButton" Content="{DynamicResource BtnRenameProfile}" Style="{StaticResource ModernButtonStyle}" Height="30" Margin="0,0,0,5" Command="{Binding RenameSelectedProfileCommand}" ToolTip="{DynamicResource RenameProfileTooltip}"/>
                                <Button AutomationProperties.AutomationId="DeleteProfileButton" Content="{DynamicResource BtnDeleteProfile}" Style="{StaticResource ModernButtonStyle}" Height="30" Command="{Binding DeleteSelectedProfileCommand}" ToolTip="{DynamicResource DeleteProfileTooltip}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Sector Count Card -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SectorCountOptionTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource SectorCountOptionDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton AutomationProperties.AutomationId="SectorCount4Radio" GroupName="SectorCountGroup" Content="{DynamicResource SectorCount4}" Margin="0,0,24,0" IsChecked="{Binding SelectedSectorCount, Converter={StaticResource IntEqualsConverter}, ConverterParameter=4}" Command="{Binding ApplySectorCountSelectionCommand}" CommandParameter="4"/>
                                <RadioButton AutomationProperties.AutomationId="SectorCount8Radio" GroupName="SectorCountGroup" Content="{DynamicResource SectorCount8}" Margin="0,0,24,0" IsChecked="{Binding SelectedSectorCount, Converter={StaticResource IntEqualsConverter}, ConverterParameter=8}" Command="{Binding ApplySectorCountSelectionCommand}" CommandParameter="8"/>
                                <RadioButton AutomationProperties.AutomationId="SectorCount12Radio" GroupName="SectorCountGroup" Content="{DynamicResource SectorCount12}" IsChecked="{Binding SelectedSectorCount, Converter={StaticResource IntEqualsConverter}, ConverterParameter=12}" Command="{Binding ApplySectorCountSelectionCommand}" CommandParameter="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Sector Actions Mapping List -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock AutomationProperties.AutomationId="SectorActionListTitleText" Text="{DynamicResource SectorActionListTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource SectorActionListDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,14"/>

                            <ItemsControl x:Name="SlotsItemsControl" ItemsSource="{Binding Slots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="95"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Col 0: Direction -->
                                                <TextBlock Text="{Binding DirectionLabel}" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" FontSize="12"/>

                                                <!-- Col 1: Icon Selector Button -->
                                                <Button Grid.Column="1" Style="{StaticResource ModernButtonStyle}" Height="30" Padding="6,0" Margin="0,0,8,0" Command="{Binding PickIconCommand}" ToolTip="{DynamicResource PickIconTooltip}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentPrimaryBrush}" Margin="0,0,4,0"
                                                              Data="{Binding VectorIconPathData, Converter={StaticResource StringToGeometryConverter}}" Visibility="{Binding HasVectorIcon, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="{Binding IconDisplayText}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="52"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Col 2: Name Input -->
                                                <TextBox Grid.Column="2" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Height="30" FontSize="12" VerticalContentAlignment="Center"/>

                                                <!-- Col 3: Type Selector (Dynamic I18n) -->
                                                <ComboBox Grid.Column="3" 
                                                              ItemsSource="{Binding ActionTypes}"
                                                              SelectedValue="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                              SelectedValuePath="Tag" 
                                                              DisplayMemberPath="DisplayText"
                                                              Style="{StaticResource FlatComboBoxStyle}" 
                                                              Height="30" Margin="0,0,8,0" FontSize="12"/>

                                                <!-- Col 4: Parameter Inputs -->
                                                <Grid Grid.Column="4" Margin="0,0,8,0">
                                                    <!-- 1. Hotkey Interactive Recorder Box -->
                                                    <controls:HotkeyRecorderBox HotkeyText="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                 Visibility="{Binding IsHotkeyType, Converter={StaticResource BoolToVis}}" Height="30" FontSize="12"/>

                                                    <!-- 2. Program Launch -->
                                                    <Grid Visibility="{Binding IsLaunchType, Converter={StaticResource BoolToVis}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                     IsReadOnly="True" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Height="30" Margin="0,0,4,0" FontSize="11" VerticalContentAlignment="Center" ToolTip="{DynamicResource SelectedAppPathTooltip}"/>
                                                        <Button Grid.Column="1" Width="34" Style="{StaticResource ModernButtonStyle}" Command="{Binding BrowseProgramCommand}" Height="30" ToolTip="{DynamicResource BrowseAppTooltip}">
                                                            <TextBlock Text="📁" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </Grid>

                                                    <!-- 3. Open Folder -->
                                                    <Grid Visibility="{Binding IsFolderType, Converter={StaticResource BoolToVis}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                     Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Height="30" Margin="0,0,4,0" FontSize="11" VerticalContentAlignment="Center" ToolTip="{DynamicResource SelectedFolderPathTooltip}"/>
                                                        <Button Grid.Column="1" Width="34" Style="{StaticResource ModernButtonStyle}" Command="{Binding BrowseFolderCommand}" Height="30" ToolTip="{DynamicResource BrowseFolderTooltip}">
                                                            <TextBlock Text="📂" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </Grid>

                                                    <!-- 4. System Preset -->
                                                    <ComboBox SelectedValue="{Binding SelectedSystemPreset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  SelectedValuePath="Key" DisplayMemberPath="Value"
                                                                  Style="{StaticResource FlatComboBoxStyle}"
                                                                  ItemsSource="{Binding Source={x:Static vm:SlotViewModel.SystemPresets}}"
                                                                  Visibility="{Binding IsSystemType, Converter={StaticResource BoolToVis}}" Height="30" FontSize="12"/>
                                                </Grid>

                                                <!-- Col 5: Launch Arguments -->
                                                <TextBox Grid.Column="5" Text="{Binding Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                             IsEnabled="{Binding IsLaunchType}" Margin="0,0,8,0" Height="30" FontSize="11" ToolTip="{DynamicResource LaunchArgsTooltip}" VerticalContentAlignment="Center"/>

                                                <!-- Col 6: Test Button -->
                                                <Button Grid.Column="6" Content="{Binding TestButtonText}" Style="{StaticResource ModernButtonStyle}" Height="30" Padding="12,0" Command="{Binding TestCommand}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</pages:SettingsPageBase>
