<pages:SettingsPageBase x:Class="WinPieGestures.Views.Pages.AppearanceSettingsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:pages="clr-namespace:WinPieGestures.Views.Pages"
        mc:Ignorable="d"
        d:DesignHeight="600" d:DesignWidth="760"
        FontFamily="Segoe UI, Microsoft YaHei UI, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality">

    <pages:SettingsPageBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 页面解析期(未挂入主框架树)即需解析 StaticResource:自合并共享样式字典 -->
                <ResourceDictionary Source="../Styles/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:SettingsPageBase.Resources>


    <Grid>
<Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock x:Name="AppearancePageHeader" Text="外观、主题与实时画布" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="AppearancePageSubheader" Text="微调轮盘视觉风格、几何形态、光学切缝与配色方案，右侧支持 60FPS 所见即所得交互测试。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                
                <!-- Split Pane: Left Config (1.15*) + Right Live Preview (1*) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left Config Controls -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,14,0">
                        <StackPanel Margin="0,0,6,0">
                            <!-- Card 0: App Interface Theme (软件界面主题风格) -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="软件控制台界面主题 (App Theme)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="定制 StarPie 控制台整体界面的视觉色彩风格，支持跟随 Windows 系统深浅色切换。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                    
                                    <!-- T17/T19：AppTheme 双向绑定(页面 DataContext 即外观 VM;T17 的根路径在此等价)（SelectedValuePath 取 Tag），选中后事件处理器只驱动窗口主题应用与预览重绘等 View 效果。 -->
                                    <ComboBox x:Name="AppThemeComboBox" Style="{StaticResource FlatComboBoxStyle}" Height="34" SelectedValuePath="Tag" SelectedValue="{Binding AppTheme, Mode=TwoWay}" SelectionChanged="AppThemeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="🌓 跟随系统 (System Auto)" Tag="System"/>
                                        <ComboBoxItem Content="☀️ 极简纯白 (Modern Light)" Tag="Light"/>
                                        <ComboBoxItem Content="🌙 极夜曜黑 (Obsidian Dark)" Tag="Dark"/>
                                        <ComboBoxItem Content="🌌 午夜深蓝 (Midnight Navy)" Tag="MidnightNavy"/>
                                        <ComboBoxItem Content="🔮 暗夜紫罗兰 (Royal Violet)" Tag="RoyalViolet"/>
                                        <ComboBoxItem Content="⚙️ 钛金深灰 (Titanium Gray)" Tag="TitaniumGray"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <!-- Theme & Style Preset -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="轮盘视觉风格与色彩" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                    
                                    <TextBlock Text="主题风格 (UiStyle):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="UiStyleComboBox" Style="{StaticResource FlatComboBoxStyle}" Height="34" Margin="0,0,0,10" SelectedValuePath="Tag" SelectedValue="{Binding UiStyle}">
                                        <ComboBoxItem Content="经典圆环 (Classic Ring)" Tag="ClassicRing"/>
                                        <ComboBoxItem Content="极简扇区 (Clean Sectors)" Tag="CleanSectors"/>
                                        <ComboBoxItem Content="液态毛玻璃 (Glassmorphism)" Tag="Glassmorphism"/>
                                        
                                    </ComboBox>

                                    <TextBlock Text="轮盘配色方案 (Wheel Theme):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ThemeComboBox" Style="{StaticResource FlatComboBoxStyle}" Height="34" SelectedValuePath="Tag" SelectedValue="{Binding SelectedTheme}">
                                            <ComboBoxItem Content="跟随系统 (System Auto)" Tag="System"/>
                                            <ComboBoxItem Content="深色模式 (Dark)" Tag="Dark"/>
                                            <ComboBoxItem Content="浅色模式 (Light)" Tag="Light"/>
                                            <ComboBoxItem Content="抹茶森林 (Matcha Forest)" Tag="MatchaForest"/>
                                            <ComboBoxItem Content="冰川透蓝 (Glacial Ice)" Tag="GlacialIce"/>
                                            <ComboBoxItem Content="莫兰迪柔灰 (Morandi Muted)" Tag="MorandiMuted"/>
                                        </ComboBox>
                                        <Button x:Name="RenameCustomColorPresetButton" Grid.Column="1" Content="✏️ 重命名预设" Style="{StaticResource ModernButtonStyle}" Height="34" Margin="8,0,0,0" Padding="12,0" Visibility="{Binding IsCustomPresetSelected, Converter={StaticResource BoolToVis}}" Command="{Binding RenamePresetCommand}" ToolTip="重命名当前选中的自定义配色方案预设"/>
                                    </Grid>

                                                                    <!-- Card 1.5: Custom Advanced Colors (Collapsible) -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <Expander x:Name="CustomColorExpander" IsExpanded="{Binding IsCustomColorExpanderExpanded}" Background="Transparent" BorderThickness="0">
                                    <Expander.Header>
                                        <StackPanel Margin="0,2,0,2">
                                            <TextBlock x:Name="CustomColorsExpanderTitleText" Text="🎨 自定义高级配色与色彩微调" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="CustomColorsExpanderDescText" Text="展开后可精准微调扇区底色、高亮光晕、边框线条、文字与光弧等各项色彩。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel x:Name="CustomColorsPanel" Margin="0,12,0,4">
                                        <TextBlock Text="自定义十六进制色彩 (色盘调色 / 屏幕吸色):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                        
                                        <!-- Sector Normal Color -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="68"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="扇区底色:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBox x:Name="CustomSectorBgTextBox" Grid.Column="1" Height="28" Text="{Binding CustomSectorBgText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                            <Button Grid.Column="2" Width="28" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="打开调色板选取颜色" Command="{Binding PickColorCommand}" CommandParameter="CustomSectorBg" Style="{StaticResource ModernButtonStyle}">
                                                <Border x:Name="CustomSectorBgPreview" Width="20" Height="20" CornerRadius="3" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Background="{Binding CustomSectorBgBrush}"/>
                                            </Button>
                                            <Button Grid.Column="3" Content="🔍" Width="28" Height="28" Padding="0" ToolTip="从屏幕任意位置吸取颜色" Command="{Binding PickEyedropperCommand}" CommandParameter="CustomSectorBg" Style="{StaticResource ModernButtonStyle}"/>
                                        </Grid>

                                        <!-- Sector Normal Border -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="68"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="扇区边框:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBox x:Name="CustomSectorBorderTextBox" Grid.Column="1" Height="28" Text="{Binding CustomSectorBorderText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                            <Button Grid.Column="2" Width="28" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="打开调色板选取颜色" Command="{Binding PickColorCommand}" CommandParameter="CustomSectorBorder" Style="{StaticResource ModernButtonStyle}">
                                                <Border x:Name="CustomSectorBorderPreview" Width="20" Height="20" CornerRadius="3" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Background="{Binding CustomSectorBorderBrush}"/>
                                            </Button>
                                            <Button Grid.Column="3" Content="🔍" Width="28" Height="28" Padding="0" ToolTip="从屏幕任意位置吸取颜色" Command="{Binding PickEyedropperCommand}" CommandParameter="CustomSectorBorder" Style="{StaticResource ModernButtonStyle}"/>
                                        </Grid>

                                        <!-- Sector Highlight Color -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="68"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="高亮底色:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBox x:Name="CustomHighlightBgTextBox" Grid.Column="1" Height="28" Text="{Binding CustomHighlightBgText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                            <Button Grid.Column="2" Width="28" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="打开调色板选取颜色" Command="{Binding PickColorCommand}" CommandParameter="CustomHighlightBg" Style="{StaticResource ModernButtonStyle}">
                                                <Border x:Name="CustomHighlightBgPreview" Width="20" Height="20" CornerRadius="3" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Background="{Binding CustomHighlightBgBrush}"/>
                                            </Button>
                                            <Button Grid.Column="3" Content="🔍" Width="28" Height="28" Padding="0" ToolTip="从屏幕任意位置吸取颜色" Command="{Binding PickEyedropperCommand}" CommandParameter="CustomHighlightBg" Style="{StaticResource ModernButtonStyle}"/>
                                        </Grid>

                                        <!-- Sector Highlight Border -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="68"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="高亮边框:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBox x:Name="CustomHighlightBorderTextBox" Grid.Column="1" Height="28" Text="{Binding CustomHighlightBorderText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                            <Button Grid.Column="2" Width="28" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="打开调色板选取颜色" Command="{Binding PickColorCommand}" CommandParameter="CustomHighlightBorder" Style="{StaticResource ModernButtonStyle}">
                                                <Border x:Name="CustomHighlightBorderPreview" Width="20" Height="20" CornerRadius="3" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Background="{Binding CustomHighlightBorderBrush}"/>
                                            </Button>
                                            <Button Grid.Column="3" Content="🔍" Width="28" Height="28" Padding="0" ToolTip="从屏幕任意位置吸取颜色" Command="{Binding PickEyedropperCommand}" CommandParameter="CustomHighlightBorder" Style="{StaticResource ModernButtonStyle}"/>
                                        </Grid>

                                        <!-- Text Color -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="68"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="文字颜色:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBox x:Name="CustomTextTextBox" Grid.Column="1" Height="28" Text="{Binding CustomTextText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                            <Button Grid.Column="2" Width="28" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="打开调色板选取颜色" Command="{Binding PickColorCommand}" CommandParameter="CustomText" Style="{StaticResource ModernButtonStyle}">
                                                <Border x:Name="CustomTextPreview" Width="20" Height="20" CornerRadius="3" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Background="{Binding CustomTextBrush}"/>
                                            </Button>
                                            <Button Grid.Column="3" Content="🔍" Width="28" Height="28" Padding="0" ToolTip="从屏幕任意位置吸取颜色" Command="{Binding PickEyedropperCommand}" CommandParameter="CustomText" Style="{StaticResource ModernButtonStyle}"/>
                                        </Grid>

                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="SaveCustomColorPresetButton" Content="💾 保存当前颜色为自定义配色预设..." Style="{StaticResource ModernButtonStyle}" Height="30" FontWeight="Medium" Command="{Binding SavePresetCommand}"/>
                                            <Button x:Name="DeletePresetInPanelButton" Grid.Column="1" Content="🗑️ 删除预设" Style="{StaticResource ModernButtonStyle}" Height="30" Margin="8,0,0,0" Padding="12,0" Visibility="{Binding IsCustomPresetSelected, Converter={StaticResource BoolToVis}}" Command="{Binding DeletePresetCommand}" ToolTip="删除当前选中的自定义配色方案预设"/>
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                            </Border>

                            <!-- Highlight Glow & Luminous Halo Controls (高亮边缘光晕与发光特效) -->
                                    <TextBlock Text="高亮边缘光晕模式 (Highlight Glow):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4"/>
                                    <ComboBox x:Name="HighlightGlowPresetComboBox" Style="{StaticResource FlatComboBoxStyle}" Height="34" Margin="0,0,0,8" SelectedValuePath="Tag" SelectedValue="{Binding HighlightGlowPreset}">
                                        <ComboBoxItem Content="🌈 跟随主题高亮色 (Auto / Follow Theme)" Tag="Auto"/>
                                        <ComboBoxItem Content="💜 丁香晶紫 (Lilac Violet #A855F7)" Tag="Lilac"/>
                                        <ComboBoxItem Content="💙 冰川湛蓝 (Glacial Blue #3B82F6)" Tag="Blue"/>
                                        <ComboBoxItem Content="💚 翡翠荧绿 (Emerald Green #10B981)" Tag="Emerald"/>
                                        <ComboBoxItem Content="💖 樱花粉晕 (Sakura Rose #EC4899)" Tag="Rose"/>
                                        <ComboBoxItem Content="🧡 琥珀金光 (Amber Gold #F59E0B)" Tag="Amber"/>
                                        <ComboBoxItem Content="🔴 珊瑚赤光 (Coral Red #EF4444)" Tag="Red"/>
                                        <ComboBoxItem Content="⚪ 冰魄纯白 (Pure Ice White #FFFFFF)" Tag="White"/>
                                        <ComboBoxItem Content="🎨 自定义光晕颜色 (Custom Glow Color)" Tag="Custom"/>
                                    </ComboBox>

                                    <!-- Custom Highlight Glow Color Row -->
                                    <Grid x:Name="CustomHighlightGlowPanel" Visibility="{Binding IsCustomGlowVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="光晕色值:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="HighlightGlowColorTextBox" Grid.Column="1" Height="28" Text="{Binding HighlightGlowColorText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                        <Button Grid.Column="2" Width="28" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="打开调色板选取光晕颜色" Command="{Binding PickColorCommand}" CommandParameter="HighlightGlowColor" Style="{StaticResource ModernButtonStyle}">
                                            <Border x:Name="HighlightGlowColorPreview" Width="20" Height="20" CornerRadius="3" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Background="{Binding HighlightGlowColorBrush}"/>
                                        </Button>
                                        <Button Grid.Column="3" Content="🔍" Width="28" Height="28" Padding="0" ToolTip="从屏幕任意位置吸取光晕颜色" Command="{Binding PickEyedropperCommand}" CommandParameter="HighlightGlowColor" Style="{StaticResource ModernButtonStyle}"/>
                                    </Grid>

                                    <!-- Highlight Glow Blur Radius -->
                                    <TextBlock Text="光晕弥散半径 (Glow Radius):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="HighlightGlowRadiusSlider" Minimum="8" Maximum="48" TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" Value="{Binding HighlightGlowRadius}"/>
                                        <TextBlock x:Name="HighlightGlowRadiusLabel" Grid.Column="1" Text="{Binding HighlightGlowRadiusLabel}" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Highlight Glow Opacity -->
                                    <TextBlock Text="光晕不透明度 (Glow Opacity):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="HighlightGlowOpacitySlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Value="{Binding HighlightGlowOpacityPercent}"/>
                                        <TextBlock x:Name="HighlightGlowOpacityLabel" Grid.Column="1" Text="{Binding HighlightGlowOpacityLabel}" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Geometry Dimensions & Advanced Shapes -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="几何形态与尺寸微调" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,10"/>
                                    
                                    <!-- Shape Selector -->
                                    <TextBlock Text="扇区切削形态 (Shape):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ShapeComboBox" Style="{StaticResource FlatComboBoxStyle}" Height="34" Margin="0,0,0,10" SelectedValuePath="Tag" SelectedValue="{Binding Shape}">
                                        <ComboBoxItem Content="经典紧凑扇区 (Original)" Tag="Original"/>
                                        <ComboBoxItem Content="独立圆形卡片 (Circle)" Tag="Circle"/>
                                        <ComboBoxItem Content="悬浮圆角胶囊 (Capsule)" Tag="RoundedCapsule"/>
                                        <ComboBoxItem Content="蜂巢六边形矩阵 (HexagonHive)" Tag="HexagonHive"/>
                                    </ComboBox>

                                    <!-- Sector Gap -->
                                    <TextBlock Text="扇区光学缝隙间距 (Gap):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SectorGapSlider" Minimum="0" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Value="{Binding SectorGap}"/>
                                        <TextBlock x:Name="SectorGapLabel" Grid.Column="1" Text="{Binding SectorGapLabel}" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Sector Corner Radius / Fillet -->
                                    <TextBlock Text="扇区边缘平滑倒角 (Corner Radius):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SectorCornerRadiusSlider" Minimum="0" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Value="{Binding SectorCornerRadius}"/>
                                        <TextBlock x:Name="SectorCornerRadiusLabel" Grid.Column="1" Text="{Binding SectorCornerRadiusLabel}" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    
                                    <!-- Wheel Radius -->
                                    <TextBlock Text="轮盘整体半径 (外径):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="WheelRadiusSlider" Minimum="100" Maximum="200" TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" Value="{Binding WheelRadius}"/>
                                        <TextBlock x:Name="WheelRadiusLabel" Grid.Column="1" Text="{Binding WheelRadiusLabel}" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Inner Radius -->
                                    <TextBlock Text="扇区内半径 (Inner):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="InnerRadiusSlider" Minimum="30" Maximum="90" TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" Value="{Binding InnerRadius}"/>
                                        <TextBlock x:Name="InnerRadiusLabel" Grid.Column="1" Text="{Binding InnerRadiusLabel}" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Core Radius -->
                                    <TextBlock Text="中心核心圆半径 (Core):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="CoreRadiusSlider" Minimum="30" Maximum="80" TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" Value="{Binding CoreRadius}"/>
                                        <TextBlock x:Name="CoreRadiusLabel" Grid.Column="1" Text="{Binding CoreRadiusLabel}" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Typography & Layout Options -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="图标与排版选项" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                    
                                    <TextBlock Text="排版模式 (Layout Mode):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="IconLayoutModeComboBox" Style="{StaticResource FlatComboBoxStyle}" Height="34" Margin="0,0,0,10" SelectedValuePath="Tag" SelectedValue="{Binding IconLayoutMode}">
                                        <ComboBoxItem Content="图标 + 文字 (双行居中)" Tag="IconAndText"/>
                                        <ComboBoxItem Content="仅显示图标 (极大化居中)" Tag="IconOnly"/>
                                        <ComboBoxItem Content="仅显示文字 (纯文字居中)" Tag="TextOnly"/>
                                    </ComboBox>

                                    <!-- Sector Icon Size -->
                                    <TextBlock Text="图标尺寸大小 (Icon Size):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SectorIconSizeSlider" Minimum="14" Maximum="36" SmallChange="1" LargeChange="2" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Value="{Binding SectorIconSize}"/>
                                        <TextBlock x:Name="SectorIconSizeLabel" Grid.Column="1" Text="{Binding SectorIconSizeLabel}" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Sector Font Size -->
                                    <TextBlock Text="文字字号大小 (Font Size):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SectorFontSizeSlider" Minimum="8" Maximum="18" SmallChange="0.5" LargeChange="1.0" TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Value="{Binding SectorFontSize}"/>
                                        <TextBlock x:Name="SectorFontSizeLabel" Grid.Column="1" Text="{Binding SectorFontSizeLabel}" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <CheckBox x:Name="ShowTextCheckBox" Content="在轮盘扇区中显示动作名称文字" Style="{StaticResource ToggleSwitchStyle}" Margin="0,4,0,0" IsChecked="{Binding ShowText}"/>
                                </StackPanel>
                            </Border>

                            <!-- Center Core & Pattern Options -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="中心核圆与图案设置" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                                    <!-- T17/T19：ShowCoreIcon 双向绑定；事件处理器只保留预览重绘 View 效果。 -->
                                    <CheckBox x:Name="ShowCoreIconCheckBox" Content="显示核圆中心图标 / 图案" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,0,10" IsChecked="{Binding ShowCoreIcon, Mode=TwoWay}" Checked="ShowCoreIconCheckBox_Changed" Unchecked="ShowCoreIconCheckBox_Changed"/>

                                    <TextBlock Text="核圆图案类型 (Core Pattern):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <!-- T17/T19：CoreIconType 双向绑定（SelectedValuePath 取 Tag）；事件处理器只保留核圆预览面板/图标同步等 View 效果。 -->
                                    <ComboBox x:Name="CoreIconTypeComboBox" Style="{StaticResource FlatComboBoxStyle}" Height="34" Margin="0,0,0,10" SelectedValuePath="Tag" SelectedValue="{Binding CoreIconType, Mode=TwoWay}" SelectionChanged="CoreIconTypeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="✕ 默认取消叉号 (Exit / Close)" Tag="Exit"/>
                                        <ComboBoxItem Content="⌖ 十字准心 (Crosshair)" Tag="Crosshair"/>
                                        <ComboBoxItem Content="⊞ Windows 微标 (Windows Logo)" Tag="Windows"/>
                                        <ComboBoxItem Content="⦿ 极简靶心圆点 (Bullseye Dot)" Tag="Dot"/>
                                        <ComboBoxItem Content="⌂ 快捷主页 (Home)" Tag="Home"/>
                                        <ComboBoxItem Content="⏻ 电源能量 (Power)" Tag="Power"/>
                                        <ComboBoxItem Content="🧭 极简罗盘 (Compass)" Tag="Compass"/>
                                        <ComboBoxItem Content="🐾 萌宠猫爪 (Cute Cat Paw)" Tag="CatPaw"/>
                                        <ComboBoxItem Content="✨ 自定义矢量图标 (Custom Icon)" Tag="Custom"/>
                                        <ComboBoxItem Content="🖼️ 自定义图片文件 (Custom Image)" Tag="Image"/>
                                    </ComboBox>

                                    <!-- Custom Core Vector Icon Row -->
                                    <Grid x:Name="CustomCoreIconPanel" Visibility="Collapsed" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path x:Name="CustomCoreIconPreviewPath" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource AccentPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="CustomCoreIconNameLabel" Text="未选择图标" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Button x:Name="PickCoreIconButton" Grid.Column="1" Content="选择图标..." Style="{StaticResource ModernButtonStyle}" Padding="12,6" Margin="8,0,0,0" Click="PickCoreIconButton_Click"/>
                                    </Grid>

                                    <!-- Custom Core Image Row -->
                                    <Grid x:Name="CustomCoreImagePanel" Visibility="Collapsed" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="CoreImageThumbnailBorder" Width="32" Height="32" CornerRadius="16" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Margin="0,0,8,0" Background="{DynamicResource InputBackgroundBrush}" VerticalAlignment="Center" ClipToBounds="True">
                                            <Image x:Name="CoreImageThumbnail" Stretch="UniformToFill"/>
                                        </Border>
                                        <!-- T17/T19：CoreCustomImagePath 双向绑定（逐键更新源，保持迁移前逐键写入语义）；缩略图随 VM PropertyChanged 刷新。 -->
                                        <TextBox x:Name="CoreImagePathTextBox" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0" Text="{Binding CoreCustomImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="自定义图片本地路径"/>
                                        <Button x:Name="BrowseCoreImageButton" Grid.Column="2" Content="浏览图片..." Style="{StaticResource ModernButtonStyle}" Height="32" Padding="12,0" Margin="0,0,6,0" Click="BrowseCoreImageButton_Click"/>
                                        <Button x:Name="ClearCoreImageButton" Grid.Column="3" Content="清除" Style="{StaticResource ModernButtonStyle}" Height="32" Padding="10,0" Click="ClearCoreImageButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Right Live Interactive Preview Canvas -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="实时交互画布 (Live Preview)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="60FPS 同步渲染" FontSize="10" FontWeight="Bold" Foreground="#059669"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="💡 移动鼠标至下方轮盘可实时测试高亮与磁吸手感" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- Live Canvas Area -->
                            <Border Grid.Row="1" Background="{DynamicResource PreviewCanvasBackgroundBrush}" BorderBrush="{DynamicResource PreviewCanvasBorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Margin="0,4,0,10">
                                <Grid>
                                    <!-- Subtle grid texture lines -->
                                    <Path Stroke="{DynamicResource PreviewGridLineBrush}" StrokeThickness="0.5" Data="M0,150 L300,150 M150,0 L150,300" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    
                                    <!-- Interactive Live Canvas -->
                                    <Canvas x:Name="LiveWheelPreviewCanvas" Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            MouseMove="LiveWheelPreviewCanvas_MouseMove" MouseLeave="LiveWheelPreviewCanvas_MouseLeave"/>
                                </Grid>
                            </Border>

                            <!-- Quick Reset Button -->
                            <Button x:Name="ResetDimensionsButton" Grid.Row="2" Content="一键重置为推荐几何尺寸" Style="{StaticResource ModernButtonStyle}" Height="32" Command="{Binding ResetDimensionsCommand}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
    </Grid>
</pages:SettingsPageBase>
