<pages:SettingsPageBase x:Class="WinPieGestures.Views.Pages.TriggerSettingsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:pages="clr-namespace:WinPieGestures.Views.Pages"
        mc:Ignorable="d"
        d:DesignHeight="600" d:DesignWidth="760"
        FontFamily="Segoe UI, Microsoft YaHei UI, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Grid>
<Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="{DynamicResource TriggerHeader}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock AutomationProperties.AutomationId="TriggerPageSubheader" Text="{DynamicResource TriggerSubheader}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,10,0">
                        <!-- Card 1: Trigger Sensitivity -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SensitivityTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource SensitivityDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,12"/>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="ThresholdSlider" Minimum="10" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Value="{Binding DragThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock x:Name="ThresholdValueLabel" Grid.Column="1" Text="{Binding DragThreshold, StringFormat={}{0:0}}" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <!-- Card 1.5: Outer Escape Cancel Setting Card -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14" SnapsToDevicePixels="True" UseLayoutRounding="True" RenderOptions.ClearTypeHint="Enabled">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource OuterEscapeTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource OuterEscapeDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,10" TextWrapping="Wrap"/>
                                <CheckBox x:Name="EnableOuterEscapeCheckBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,4,0,4" IsChecked="{Binding EnableOuterEscapeCancel, Mode=TwoWay}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="{DynamicResource OuterEscapeCheckbox}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource OuterEscapeDesc}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <!-- Escape Distance Slider (Shown when enabled) -->
                                 <StackPanel x:Name="OuterEscapeDistancePanel" Margin="0,10,0,0" Visibility="{Binding EnableOuterEscapeCancel, Converter={StaticResource BoolToVis}}">
                                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource OuterEscapeDistanceTitle}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{DynamicResource OuterEscapeDistanceDesc}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="OuterEscapeDistanceSlider" Minimum="140" Maximum="320" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Value="{Binding OuterEscapeDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock x:Name="OuterEscapeDistanceLabel" Grid.Column="1" Text="{Binding OuterEscapeDistance, StringFormat={}{0:0} px}" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Scene Isolation & Bypass -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SceneIsolationTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource SceneIsolationDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,12"/>
                                
                                <CheckBox x:Name="DisableOnFullScreenCheckBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,4,0,14" IsChecked="{Binding DisableOnFullScreen, Mode=TwoWay}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="{DynamicResource FullScreenOption}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource FullScreenOptionDesc}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource ModifierPassTitle}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                        <WrapPanel>
                                            <CheckBox Content="{DynamicResource ModifierCtrl}" Margin="0,0,20,8" IsChecked="{Binding DisableOnCtrl, Mode=TwoWay}"/>
                                            <CheckBox Content="{DynamicResource ModifierShift}" Margin="0,0,20,8" IsChecked="{Binding DisableOnShift, Mode=TwoWay}"/>
                                            <CheckBox Content="{DynamicResource ModifierAlt}" Margin="0,0,20,8" IsChecked="{Binding DisableOnAlt, Mode=TwoWay}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Process Exclusion Blacklist -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.03"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource BlacklistTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource BlacklistDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,12"/>
                                
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox AutomationProperties.AutomationId="NewBlacklistProcessTextBox" Height="34" Margin="0,0,8,0"
                                             FontSize="12" VerticalContentAlignment="Center"
                                             ToolTip="{DynamicResource BlacklistPlaceholder}"
                                              Text="{Binding NewBlacklistProcess, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddBlacklistFromInputCommand}"/></TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="1" Content="{DynamicResource BtnPickProcess}" 
                                            Style="{StaticResource ModernButtonStyle}" Height="34" Padding="14,0" Margin="0,0,8,0" 
                                            Command="{Binding BrowseBlacklistCommand}" ToolTip="{DynamicResource BlacklistBrowseTooltip}"/>
                                    <Button Grid.Column="2" AutomationProperties.AutomationId="AddBlacklistButton" Content="{DynamicResource BtnAddProcess}" 
                                            Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="16,0" 
                                            Command="{Binding AddBlacklistFromInputCommand}" ToolTip="{DynamicResource BlacklistAddTooltip}"/>
                                </Grid>

                                <ListBox x:Name="BlacklistListBox" Height="110" Margin="0,0,0,8" ItemsSource="{Binding BlacklistProcesses}" SelectedItem="{Binding SelectedBlacklistProcess, Mode=TwoWay}">
                                    <ListBox.InputBindings><KeyBinding Key="Delete" Command="{Binding DeleteBlacklistProcessCommand}"/><KeyBinding Key="Back" Command="{Binding DeleteBlacklistProcessCommand}"/></ListBox.InputBindings>
                                </ListBox>
                                <Button AutomationProperties.AutomationId="DeleteBlacklistButton" Content="{DynamicResource BtnDeleteProcess}" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Right" Height="30" Padding="12,0" Command="{Binding DeleteBlacklistProcessCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
    </Grid>
</pages:SettingsPageBase>
