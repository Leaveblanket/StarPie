<pages:SettingsPageBase x:Class="WinPieGestures.Views.Pages.AboutSettingsPage"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:pages="clr-namespace:WinPieGestures.Views.Pages"
                        d:DesignHeight="600" d:DesignWidth="760"
                        FontFamily="Segoe UI, Microsoft YaHei UI, Arial"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        RenderOptions.ClearTypeHint="Enabled"
                        SnapsToDevicePixels="True"
                        TextOptions.TextFormattingMode="Display"
                        TextOptions.TextRenderingMode="ClearType"
                        UseLayoutRounding="True" mc:Ignorable="d">

    <pages:SettingsPageBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  页面解析期(未挂入主框架树)即需解析 StaticResource:自合并共享样式字典  -->
                <ResourceDictionary Source="../Styles/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </pages:SettingsPageBase.Resources>


    <Grid d:Background="Yellow" d:Height="900">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="关于与更新日志" />
                <TextBlock Margin="0,4,0,0" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="StarPie 现代鼠标轮盘笔势工具版本信息与完整演进历程。" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <Border Margin="0,0,0,14" Padding="20"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.03" ShadowDepth="1"
                                              Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" VerticalAlignment="Center"
                                    Background="Transparent" CornerRadius="10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" Opacity="0.16" ShadowDepth="1"
                                                      Color="#000000" />
                                </Border.Effect>
                                <Image Width="48" Height="48"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="logo.png" Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="StarPie" />
                                    <Border Margin="8,0,0,0" Padding="6,2" VerticalAlignment="Center"
                                            Background="{DynamicResource NavTabActiveBgBrush}"
                                            CornerRadius="4">
                                        <TextBlock FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentPrimaryBrush}"
                                                   Text="v1.4.1" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="高质感、极速现代 Windows 鼠标轮盘笔势工具" />
                            </StackPanel>
                            <Button Grid.Column="2" AutomationProperties.AutomationId="OpenChangelogButton" Height="34"
                                    VerticalAlignment="Center" Command="{Binding OpenChangelogCommand}"
                                    Content="{DynamicResource BtnOpenChangelog}"
                                    Style="{StaticResource ModernButtonStyle}" />
                        </Grid>
                    </Border>

                    <Border Margin="0,0,0,14" Padding="20"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12"
                            RenderOptions.ClearTypeHint="Enabled"
                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.03" ShadowDepth="1"
                                              Color="#000000" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,10" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="v1.4.1 顺势外甩脱离取消 &amp; 防多开单实例 &amp; ClearType 字体锐化 &amp; 多维重命名" />
                            <TextBlock Margin="0,0,0,4" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="• 🚀 新增【顺势外甩脱离取消】机制，超距向外甩出光标即可秒级安全取消，无需折返中心；" />
                            <TextBlock Margin="0,0,0,4" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="• 🛡️ 引入全局单实例 Mutex 互斥锁，彻底杜绝程序重复多开与多托盘图标驻留；" />
                            <TextBlock Margin="0,0,0,4" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="• 🔤 全面重构 WPF ClearType 亚像素抗锯齿与物理像素排版，彻底解决折叠面板文字发虚模糊；" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="• ✏️ 为自定义配色预设与配置方案增加一键【重命名】按钮与快捷编辑入口。" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,14" Padding="20"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.03" ShadowDepth="1"
                                              Color="#000000" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,10" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="v1.4.0 自定义图标导入 &amp; 动作视觉引导 &amp; 配色折叠 &amp; 历史记录收纳" />
                            <TextBlock Margin="0,0,0,4" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="• 🎨 支持导入自定义 SVG 矢量图与 PNG/ICO/JPG 本地图片图标，全端自适应无损渲染；" />
                            <TextBlock Margin="0,0,0,4" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="• 📁 启动程序与打开文件夹右侧方框强化为高对比度引导图标，提升视觉交互指引；" />
                            <TextBlock Margin="0,0,0,4" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="• 🛠️ 将自定义高级配色单列为折叠卡片，默认折叠收纳，保持界面清爽克制；" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="• 📜 版本演进里程碑默认仅展示最近三条更新，早期历史记录折叠收纳。" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,14" Padding="20"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.03" ShadowDepth="1"
                                              Color="#000000" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,10" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="v1.3.9 打开文件夹功能 &amp; 全局界面语言统一性强化" />
                            <TextBlock Margin="0,0,0,4" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="• 📂 新增【打开文件夹】专属动作类型，支持现代化文件目录选择器与一键直达资源管理器；" />
                            <TextBlock Margin="0,0,0,4" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="• 🌐 全面消除 Raw 字典键与混排语言，选择程序、颜色选择器、图标库与主控制台语言 100% 统一；" />
                            <TextBlock Margin="0,0,0,4" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="• ⚡ 轮盘方位动作下拉框与测试按钮支持中/繁/英/日四国语言即时热切换无需重启；" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="• 🪶 继续保持 3~5MB 极致轻量常驻内存与低于 2ms 毫秒级极速响应。" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,14" Padding="20"
                            Background="{DynamicResource SubtleCardBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,10" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="v1.3.8 StarPie 品牌视觉升级 &amp; 原生圆角星轨图标 &amp; 托盘图标自愈修复" />
                            <TextBlock Margin="0,0,0,6" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="• 【全新 StarPie 品牌与原生圆角图标】正式更名为 StarPie，搭载星芒与光弧指引之星新 Logo；修复任务栏图标直角黑边，采用 4x 超采样生成全透明抗锯齿圆角 ICO/PNG。" />
                            <TextBlock Margin="0,0,0,6" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="• 【系统托盘 NotifyIcon 嵌入式加载修复】重构托盘图标加载管线，支持进程直接提取、WPF 嵌入式资源流与外部单文件多重自愈回退，彻底解决托盘图标空白/默认图样问题。" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="• 【软件控制台侧边栏品牌排版精修】去除侧边栏 Logo 底部多余的浅蓝圆盘与突兀衬底，升级为现代圆角 Squircle 浮雕阴影与全新品牌文字排版。" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,14" Padding="20"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.03" ShadowDepth="1"
                                              Color="#000000" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,14" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="版本演进里程碑 (Milestones)" />

                            <Border Margin="0,0,0,10" Padding="0,0,0,10"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="6,2" HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource NavTabActiveBgBrush}"
                                            CornerRadius="4">
                                        <TextBlock FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentPrimaryBrush}"
                                                   Text="v1.4.1" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock FontSize="12" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="自定义图标导入 &amp; 动作引导视觉强化 &amp; 配色折叠收纳 &amp; 架构精简" />
                                        <TextBlock Margin="0,2,0,0" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="支持导入自定义 SVG/PNG/ICO 图标，强化启动程序引导图标，单列自定义高级配色折叠卡片，精简收纳历史版本。" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right"
                                               VerticalAlignment="Top" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="2026-08-24" />
                                </Grid>
                            </Border>

                            <!--  Milestone 2: v1.3.9 (Recent)  -->
                            <Border Margin="0,0,0,10" Padding="0,0,0,10"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="6,2" HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource NavTabActiveBgBrush}"
                                            CornerRadius="4">
                                        <TextBlock FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentPrimaryBrush}"
                                                   Text="v1.3.9" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock FontSize="12" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="打开文件夹动作类型 &amp; 全局界面语言统一性强化" />
                                        <TextBlock Margin="0,2,0,0" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="新增打开文件夹专属动作类型与目录选择器，消除 Raw 字典键与混排语言，全弹窗国际化深度适配。" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right"
                                               VerticalAlignment="Top" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="2026-08-24" />
                                </Grid>
                            </Border>

                            <!--  Milestone 3: v1.3.8 (Recent)  -->
                            <Border Margin="0,0,0,10" Padding="0,0,0,10"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="6,2" HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource NavTabActiveBgBrush}"
                                            CornerRadius="4">
                                        <TextBlock FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentPrimaryBrush}"
                                                   Text="v1.3.8" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock FontSize="12" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="StarPie 品牌视觉升级 &amp; 原生圆角星轨图标 &amp; 托盘图标自愈修复" />
                                        <TextBlock Margin="0,2,0,0" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="升级 StarPie 品牌，修复任务栏圆角与托盘图标缺失，重构控制台侧边栏 Logo 与排版。" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right"
                                               VerticalAlignment="Top" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="2026-08-23" />
                                </Grid>
                            </Border>

                            <!--  Collapsible Older Milestones  -->
                            <Expander AutomationProperties.AutomationId="OlderMilestonesExpander" Margin="0,4,0,0"
                                      Background="Transparent" BorderThickness="0"
                                      Header="{DynamicResource MilestonesOlderExpander}"
                                      IsExpanded="False">
                                <StackPanel Margin="0,8,0,0">
                                    <!--  v1.3.4  -->
                                    <Border Margin="0,0,0,10" Padding="0,0,0,10"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <Border Padding="6,2" HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource SubtleCardBrush}"
                                                    CornerRadius="4">
                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="v1.3.4" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock FontSize="12" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Text="纯白主题画布渲染优化 &amp; 全局设置记忆 &amp; 极简内存瘦身" />
                                                <TextBlock Margin="0,2,0,0" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="优化纯白主题下实时画布背景色彩，增加关闭与退出自动记忆功能，大幅优化内存占用至15-25MB。" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" HorizontalAlignment="Right"
                                                       VerticalAlignment="Top" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="2026-08-23" />
                                        </Grid>
                                    </Border>

                                    <!--  v1.3.3  -->
                                    <Border Margin="0,0,0,10" Padding="0,0,0,10"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <Border Padding="6,2" HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource SubtleCardBrush}"
                                                    CornerRadius="4">
                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="v1.3.3" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock FontSize="12" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Text="4/12键方位全流程适配修复 &amp; 扇区切削形态精简" />
                                                <TextBlock Margin="0,2,0,0" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="修复4键/12键切换无响应问题，支持动态自适应缩放与钟表映射，精简保留四大核心高质感形态。" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" HorizontalAlignment="Right"
                                                       VerticalAlignment="Top" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="2026-08-22" />
                                        </Grid>
                                    </Border>

                                    <!--  v1.3.2  -->
                                    <Border Margin="0,0,0,10" Padding="0,0,0,10"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <Border Padding="6,2" HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource SubtleCardBrush}"
                                                    CornerRadius="4">
                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="v1.3.2" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock FontSize="12" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Text="轮盘图标大小调节 &amp; 光弧极简重构" />
                                                <TextBlock Margin="0,2,0,0" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="新增图标大小滑动微调，重构光弧同心导轨与悬浮节点，优化比例。" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" HorizontalAlignment="Right"
                                                       VerticalAlignment="Top" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="2026-08-22" />
                                        </Grid>
                                    </Border>

                                    <!--  v1.3.1  -->
                                    <Border Margin="0,0,0,10" Padding="0,0,0,10"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <Border Padding="6,2" HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource SubtleCardBrush}"
                                                    CornerRadius="4">
                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="v1.3.1" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock FontSize="12" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Text="新增液态水滴与光弧轨道形态 &amp; 文字字号调节" />
                                                <TextBlock Margin="0,2,0,0" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="精简合并圆角胶囊形态，新增液态水滴与光弧轨道形态，支持自定义文字大小。" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" HorizontalAlignment="Right"
                                                       VerticalAlignment="Top" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="2026-08-22" />
                                        </Grid>
                                    </Border>

                                    <!--  v1.3.0  -->
                                    <Border Margin="0,0,0,10" Padding="0,0,0,10"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <Border Padding="6,2" HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource SubtleCardBrush}"
                                                    CornerRadius="4">
                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="v1.3.0" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
