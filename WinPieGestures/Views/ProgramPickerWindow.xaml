<Window x:Class="WinPieGestures.Views.ProgramPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择程序 - StarPie" 
        Height="540" Width="440"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI, Microsoft YaHei"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="PickerBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonDefaultBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonDefaultBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultFgBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBgBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryPickerBtn" TargetType="Button" BasedOn="{StaticResource PickerBtn}">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title / Info -->
            <RowDefinition Height="Auto"/> <!-- Search Box -->
            <RowDefinition Height="*"/>    <!-- Programs List -->
            <RowDefinition Height="Auto"/> <!-- Status / Loading indicator -->
            <RowDefinition Height="Auto"/> <!-- Actions -->
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock x:Name="HeaderTitleText" Grid.Row="0" Text="从已安装的软件和开始菜单中选择" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
        
        <!-- Search bar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <TextBox Name="SearchTextBox" Height="34" VerticalContentAlignment="Center" Padding="30,0,10,0"
                     Background="{DynamicResource InputBackgroundBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource InputBorderBrush}"
                     BorderThickness="1"
                     FontSize="12"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="🔍" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
            <TextBlock x:Name="SearchPlaceholderText" Text="搜索软件名称、可执行文件或路径..." FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.6"
                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="30,0,0,0" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- List View -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
            <ListView Name="ProgramsListView" BorderThickness="0" Background="Transparent"
                      ItemsSource="{Binding DisplayedPrograms}"
                      SelectedItem="{Binding SelectedProgram}"
                      MouseDoubleClick="ProgramsListView_MouseDoubleClick" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="6,4" Height="44">
                            <Image Source="{Binding IconSource}" Width="32" Height="32" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding FriendlyPath}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Width="330" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Loading / Status indicator -->
        <TextBlock Grid.Row="3" Name="StatusTextBlock" Margin="0,6,0,6" FontSize="12" FontWeight="Medium"
                   Text="{Binding StatusText}"
                   Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVisibility}}">
            <!-- 颜色必须走 Style 触发器：本地 Foreground 值会压过 DataTrigger -->
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Foreground" Value="Red"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Bottom Actions -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ManualBrowseButton" Grid.Column="0" Content="手动浏览文件..." Style="{StaticResource PickerBtn}" Height="32" Padding="14,0" Command="{Binding BrowseManuallyCommand}"/>
            <Button x:Name="OkButton" Grid.Column="2" Content="确定" Style="{StaticResource PrimaryPickerBtn}" Width="84" Height="32" Command="{Binding ConfirmCommand}" FontWeight="Bold" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Grid.Column="3" Content="取消" Style="{StaticResource PickerBtn}" Width="84" Height="32" Click="Cancel_Click"/>
        </Grid>
    </Grid>
</Window>
