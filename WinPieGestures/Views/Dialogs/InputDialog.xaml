<Window
    x:Class="WinPieGestures.Views.Dialogs.InputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding Title}"
    Width="400"
    Background="{DynamicResource WindowBackgroundBrush}"
    FontFamily="Segoe UI, Microsoft YaHei, PingFang SC"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!--  Modern Button Style  -->
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonDefaultBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonDefaultBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultFgBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                    Value="{DynamicResource ButtonHoverBgBrush}" />
                                <Setter Property="BorderBrush"
                                    Value="{DynamicResource AccentPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background"
                                    Value="{DynamicResource ItemHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Primary Dialog Button Style  -->
        <Style
            x:Key="DialogPrimaryButtonStyle"
            BasedOn="{StaticResource DialogButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                    Value="{DynamicResource AccentHoverBrush}" />
                                <Setter Property="BorderBrush"
                                    Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background"
                                    Value="{DynamicResource AccentHoverBrush}" />
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border
        Margin="10"
        Padding="22"
        Background="{DynamicResource CardBackgroundBrush}"
        BorderBrush="{DynamicResource CardBorderBrush}"
        BorderThickness="1"
        CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="16"
                Opacity="0.12"
                ShadowDepth="2"
                Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <!--  Title & Subtitle  -->
            <TextBlock
                Margin="0,0,0,4"
                FontSize="16"
                FontWeight="Bold"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="{Binding Title}" />
            <TextBlock
                Margin="0,0,0,14"
                FontSize="12"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{Binding Prompt}"
                TextWrapping="Wrap" />

            <!--  Input Box  -->
            <TextBox
                x:Name="InputTextBox"
                Height="36"
                Margin="0,0,0,18"
                Padding="8,0"
                VerticalContentAlignment="Center"
                Background="{DynamicResource InputBackgroundBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}"
                BorderThickness="1"
                FontSize="13"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ConfirmCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <!--  Action Buttons  -->
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="80"
                    Margin="0,0,10,0"
                    AutomationProperties.AutomationId="CancelButton"
                    Click="CancelButton_Click"
                    Content="{DynamicResource BtnCancel}"
                    Style="{StaticResource DialogButtonStyle}" />
                <Button
                    Width="80"
                    AutomationProperties.AutomationId="OkButton"
                    Command="{Binding ConfirmCommand}"
                    Content="{DynamicResource BtnConfirm}"
                    Style="{StaticResource DialogPrimaryButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
