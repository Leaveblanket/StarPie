<Window
    x:Class="WinPieGestures.Views.Dialogs.InputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding Title}"
    Width="400"
    Background="{DynamicResource WindowBackgroundBrush}"
    FontFamily="Segoe UI, Microsoft YaHei, PingFang SC"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <Border
        Margin="10"
        Padding="22"
        Background="{DynamicResource CardBackgroundBrush}"
        BorderBrush="{DynamicResource CardBorderBrush}"
        BorderThickness="1"
        CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="16"
                Opacity="0.12"
                ShadowDepth="2"
                Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <!--  Title & Subtitle  -->
            <TextBlock
                Margin="0,0,0,4"
                FontSize="16"
                FontWeight="Bold"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="{Binding Title}" />
            <TextBlock
                Margin="0,0,0,14"
                FontSize="12"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{Binding Prompt}"
                TextWrapping="Wrap" />

            <!--  Input Box  -->
            <TextBox
                x:Name="InputTextBox"
                Height="36"
                Margin="0,0,0,18"
                Padding="8,0"
                VerticalContentAlignment="Center"
                Background="{DynamicResource InputBackgroundBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}"
                BorderThickness="1"
                FontSize="13"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ConfirmCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <!--  Action Buttons  -->
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="80"
                    Height="34"
                    Margin="0,0,10,0"
                    AutomationProperties.AutomationId="CancelButton"
                    Click="CancelButton_Click"
                    Content="{DynamicResource BtnCancel}"
                    Style="{StaticResource ModernButtonStyle}" />
                <Button
                    Width="80"
                    Height="34"
                    AutomationProperties.AutomationId="OkButton"
                    Command="{Binding ConfirmCommand}"
                    Content="{DynamicResource BtnConfirm}"
                    Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
