<Window x:Class="WinPieGestures.Views.Dialogs.ScreenEyedropperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True" Background="#01000000"
        Cursor="Cross" KeyDown="ScreenEyedropperWindow_KeyDown"
        MouseDown="ScreenEyedropperWindow_MouseDown"
        MouseMove="ScreenEyedropperWindow_MouseMove"
        ShowInTaskbar="False" Topmost="True" WindowStyle="None">
    <!--
        全屏置顶取色覆盖层（ADR-0004：不用 Owner）。拾取状态与结果在 ScreenEyedropperViewModel；
        code-behind 只保留 Win32 取像素与放大镜摆放（ADR-0009 纯视觉白名单）。
    -->
    <Canvas IsHitTestVisible="False">
        <Border x:Name="LoupeBorder" Width="110" Height="60"
                Padding="6" Background="#EB0F172A" BorderBrush="#B4FFFFFF"
                BorderThickness="1.5" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.4" ShadowDepth="2" />
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Border Width="18" Height="18" Margin="0,0,6,0"
                            Background="{Binding SwatchHex, Converter={StaticResource HexToBrushConverter}}"
                            BorderBrush="White" BorderThickness="1" CornerRadius="4" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="Bold"
                               Foreground="White"
                               Text="{Binding HexText}" />
                </StackPanel>
                <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="9"
                           Foreground="#C8CBD5E1" Text="单击取色 / Esc取消" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
