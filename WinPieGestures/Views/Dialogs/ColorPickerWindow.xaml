<Window x:Class="WinPieGestures.Views.Dialogs.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:WinPieGestures.Views.Controls"
        Title="色彩选择器与屏幕吸管 (Color Picker)" Height="610" Width="510"
        MinHeight="560" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI, Arial">

    <Window.Resources>
        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="3.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" BorderBrush="#35000000" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="2" ShadowDepth="1" Color="#000000" Opacity="0.12"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonDefaultBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonDefaultBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultFgBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Current Color Preview -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="调色板与屏幕取色" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="在色盘中精调色彩，或使用屏幕吸管捕获任意像素。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Color Preview Card -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="64" Height="36" CornerRadius="6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                    <Grid>
                        <!-- Checkerboard for alpha -->
                        <Border CornerRadius="5" Background="{DynamicResource SubtleCardBrush}"/>
                        <Border x:Name="ColorPreviewBorder" CornerRadius="5" Background="{Binding PreviewHex, Converter={StaticResource HexToBrushConverter}}"/>
                    </Grid>
                </Border>
                <TextBox x:Name="HexInputBox" Width="95" Height="36" FontSize="13" FontWeight="SemiBold"
                         Background="{DynamicResource InputBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource InputBorderBrush}"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0" Text="{Binding HexText, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <!-- Middle Body: Spectrum Canvas & Sliders & Eyedropper & Palette -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="170"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Color Spectrum (Saturation & Value) -->
            <Border Grid.Row="0" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" ClipToBounds="True">
                <Canvas x:Name="SpectrumCanvas" Background="{Binding SpectrumHex, Converter={StaticResource HexToBrushConverter}}" behaviors:SpectrumCanvasBehavior.Command="{Binding SetSpectrumPointActionCommand}" Cursor="Cross">
                    <!-- White to Transparent Horizontal Gradient -->
                    <Rectangle Width="{Binding ActualWidth, ElementName=SpectrumCanvas}" Height="{Binding ActualHeight, ElementName=SpectrumCanvas}">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- Transparent to Black Vertical Gradient -->
                    <Rectangle Width="{Binding ActualWidth, ElementName=SpectrumCanvas}" Height="{Binding ActualHeight, ElementName=SpectrumCanvas}">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#FF000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- Draggable Spectrum Thumb -->
                    <Ellipse x:Name="SpectrumThumb" Width="14" Height="14" Stroke="White" StrokeThickness="2" Fill="Transparent" IsHitTestVisible="False" Margin="-7,-7,0,0">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.6"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Border>

            <!-- 2. Hue & Alpha Sliders -->
            <StackPanel Grid.Row="1" Margin="0,8,0,6">
                <!-- Hue Rainbow Slider -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock AutomationProperties.AutomationId="HueLabelText" Text="{DynamicResource ColorPickerHue}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <Slider x:Name="HueSlider" Grid.Column="1" Minimum="0" Maximum="360" Value="{Binding Hue}" Height="18">
                        <Slider.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FFFF0000" Offset="0.0"/>
                                <GradientStop Color="#FFFFFF00" Offset="0.17"/>
                                <GradientStop Color="#FF00FF00" Offset="0.33"/>
                                <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                                <GradientStop Color="#FF0000FF" Offset="0.67"/>
                                <GradientStop Color="#FFFF00FF" Offset="0.83"/>
                                <GradientStop Color="#FFFF0000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Slider.Background>
                    </Slider>
                </Grid>

                <!-- Alpha Opacity Slider -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock AutomationProperties.AutomationId="AlphaLabelText" Text="{DynamicResource ColorPickerAlpha}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <Slider x:Name="AlphaSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Alpha}" Height="18"/>
                </Grid>
            </StackPanel>

            <!-- 3. Screen Eyedropper Tool Button -->
            <Border Grid.Row="2" Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock AutomationProperties.AutomationId="EyedropperTitleText" Text="{DynamicResource ColorPickerEyedropperTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        <TextBlock AutomationProperties.AutomationId="EyedropperDescText" Text="{DynamicResource ColorPickerEyedropperDesc}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" AutomationProperties.AutomationId="EyedropperButton" Content="{DynamicResource ColorPickerEyedropperBtn}" Style="{StaticResource PrimaryBtn}" Padding="12,4" Height="26" FontSize="11" Command="{Binding EyedropperCommand}"/>
                </Grid>
            </Border>

            <!-- 4. Preset Color Swatches in Scrollable Container -->
            <Grid Grid.Row="3" Margin="0,2,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock AutomationProperties.AutomationId="SwatchesTitleText" Grid.Row="0" Text="{DynamicResource ColorPickerSwatches}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
                    <ScrollViewer x:Name="SwatchesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="SwatchesScrollViewer_PreviewMouseWheel">
                        <WrapPanel x:Name="SwatchesPanel" HorizontalAlignment="Center"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom Actions (Confirm / Cancel) -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" AutomationProperties.AutomationId="CancelButton" Content="{DynamicResource BtnCancel}" Style="{StaticResource ModernBtn}" Margin="0,0,8,0" Width="80" Click="Cancel_Click"/>
            <Button Grid.Column="2" AutomationProperties.AutomationId="OkButton" Content="{DynamicResource ColorPickerApply}" Style="{StaticResource PrimaryBtn}" Width="90" Command="{Binding ConfirmCommand}"/>
        </Grid>
    </Grid>
</Window>
