<Window
    x:Class="WinPieGestures.Views.Dialogs.ColorPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:WinPieGestures.Views.Controls"
    Title="色彩选择器与屏幕吸管 (Color Picker)"
    Width="510"
    Height="610"
    MinWidth="480"
    MinHeight="560"
    Background="{DynamicResource WindowBackgroundBrush}"
    FontFamily="Segoe UI, Microsoft YaHei UI, Arial"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="3.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#35000000"
                            BorderThickness="1"
                            CornerRadius="5">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="2"
                                    Opacity="0.12"
                                    ShadowDepth="1"
                                    Color="#000000" />
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush"
                                    Value="{DynamicResource AccentPrimaryBrush}" />
                                <Setter TargetName="border" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonDefaultBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonDefaultBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultFgBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="PrimaryBtn"
            BasedOn="{StaticResource ModernBtn}"
            TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Top Header & Current Color Preview  -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock
                    FontSize="17"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="{DynamicResource ColorPickerHeader}" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{DynamicResource ColorPickerSubtitle}" />
            </StackPanel>

            <!--  Color Preview Card  -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Border
                    Width="64"
                    Height="36"
                    Margin="0,0,8,0"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <!--  Checkerboard for alpha  -->
                        <Border Background="{DynamicResource SubtleCardBrush}" CornerRadius="5" />
                        <Border
                            x:Name="ColorPreviewBorder"
                            Background="{Binding PreviewHex, Converter={StaticResource HexToBrushConverter}}"
                            CornerRadius="5" />
                    </Grid>
                </Border>
                <TextBox
                    x:Name="HexInputBox"
                    Width="95"
                    Height="36"
                    Margin="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="{Binding HexText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <!--  Middle Body: Spectrum Canvas & Sliders & Eyedropper & Palette  -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="170" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  1. Color Spectrum (Saturation & Value)  -->
            <Border
                Grid.Row="0"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                ClipToBounds="True"
                CornerRadius="8">
                <Canvas
                    x:Name="SpectrumCanvas"
                    behaviors:SpectrumCanvasBehavior.Command="{Binding SetSpectrumPointActionCommand}"
                    Background="{Binding SpectrumHex, Converter={StaticResource HexToBrushConverter}}"
                    Cursor="Cross">
                    <!--  White to Transparent Horizontal Gradient  -->
                    <Rectangle Width="{Binding ActualWidth, ElementName=SpectrumCanvas}"
                        Height="{Binding ActualHeight, ElementName=SpectrumCanvas}">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#FFFFFFFF" />
                                <GradientStop Offset="1" Color="#00FFFFFF" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!--  Transparent to Black Vertical Gradient  -->
                    <Rectangle Width="{Binding ActualWidth, ElementName=SpectrumCanvas}"
                        Height="{Binding ActualHeight, ElementName=SpectrumCanvas}">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#00000000" />
                                <GradientStop Offset="1" Color="#FF000000" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!--  Draggable Spectrum Thumb  -->
                    <Ellipse
                        x:Name="SpectrumThumb"
                        Width="14"
                        Height="14"
                        Margin="-7,-7,0,0"
                        Fill="Transparent"
                        IsHitTestVisible="False"
                        Stroke="White"
                        StrokeThickness="2">
                        <Ellipse.Effect>
                            <DropShadowEffect
                                BlurRadius="4"
                                Opacity="0.6"
                                ShadowDepth="1"
                                Color="#000000" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Border>

            <!--  2. Hue & Alpha Sliders  -->
            <StackPanel Grid.Row="1" Margin="0,8,0,6">
                <!--  Hue Rainbow Slider  -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="HueLabelText"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{DynamicResource ColorPickerHue}" />
                    <Slider
                        x:Name="HueSlider"
                        Grid.Column="1"
                        Height="18"
                        Maximum="360"
                        Minimum="0"
                        Value="{Binding Hue}">
                        <Slider.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Offset="0.0" Color="#FFFF0000" />
                                <GradientStop Offset="0.17" Color="#FFFFFF00" />
                                <GradientStop Offset="0.33" Color="#FF00FF00" />
                                <GradientStop Offset="0.5" Color="#FF00FFFF" />
                                <GradientStop Offset="0.67" Color="#FF0000FF" />
                                <GradientStop Offset="0.83" Color="#FFFF00FF" />
                                <GradientStop Offset="1.0" Color="#FFFF0000" />
                            </LinearGradientBrush>
                        </Slider.Background>
                    </Slider>
                </Grid>

                <!--  Alpha Opacity Slider  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="AlphaLabelText"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{DynamicResource ColorPickerAlpha}" />
                    <Slider
                        x:Name="AlphaSlider"
                        Grid.Column="1"
                        Height="18"
                        Maximum="255"
                        Minimum="0"
                        Value="{Binding Alpha}" />
                </Grid>
            </StackPanel>

            <!--  3. Screen Eyedropper Tool Button  -->
            <Border
                Grid.Row="2"
                Margin="0,0,0,6"
                Padding="10,5"
                Background="{DynamicResource SubtleCardBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            AutomationProperties.AutomationId="EyedropperTitleText"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource AccentPrimaryBrush}"
                            Text="{DynamicResource ColorPickerEyedropperTitle}" />
                        <TextBlock
                            AutomationProperties.AutomationId="EyedropperDescText"
                            FontSize="10"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{DynamicResource ColorPickerEyedropperDesc}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Height="26"
                        Padding="12,4"
                        AutomationProperties.AutomationId="EyedropperButton"
                        Command="{Binding EyedropperCommand}"
                        Content="{DynamicResource ColorPickerEyedropperBtn}"
                        FontSize="11"
                        Style="{StaticResource PrimaryBtn}" />
                </Grid>
            </Border>

            <!--  4. Preset Color Swatches in Scrollable Container  -->
            <Grid Grid.Row="3" Margin="0,2,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,4"
                    AutomationProperties.AutomationId="SwatchesTitleText"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{DynamicResource ColorPickerSwatches}" />
                <Border
                    Grid.Row="1"
                    Padding="6"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <ScrollViewer
                        x:Name="SwatchesScrollViewer"
                        HorizontalScrollBarVisibility="Disabled"
                        PreviewMouseWheel="SwatchesScrollViewer_PreviewMouseWheel"
                        VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="SwatchesPanel" HorizontalAlignment="Center" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!--  Bottom Actions (Confirm / Cancel)  -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="1"
                Width="80"
                Margin="0,0,8,0"
                AutomationProperties.AutomationId="CancelButton"
                Click="Cancel_Click"
                Content="{DynamicResource BtnCancel}"
                Style="{StaticResource ModernBtn}" />
            <Button
                Grid.Column="2"
                Width="90"
                AutomationProperties.AutomationId="OkButton"
                Command="{Binding ConfirmCommand}"
                Content="{DynamicResource ColorPickerApply}"
                Style="{StaticResource PrimaryBtn}" />
        </Grid>
    </Grid>
</Window>
