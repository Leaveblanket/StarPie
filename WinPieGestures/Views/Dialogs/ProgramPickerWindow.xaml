<Window
    x:Class="WinPieGestures.Views.Dialogs.ProgramPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="选择程序 - StarPie"
    Width="440"
    Height="540"
    Background="{DynamicResource WindowBackgroundBrush}"
    FontFamily="Segoe UI, Microsoft YaHei"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  Title / Info  -->
            <RowDefinition Height="Auto" />
            <!--  Search Box  -->
            <RowDefinition Height="*" />
            <!--  Programs List  -->
            <RowDefinition Height="Auto" />
            <!--  Status / Loading indicator  -->
            <RowDefinition Height="Auto" />
            <!--  Actions  -->
        </Grid.RowDefinitions>

        <!--  Header  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            AutomationProperties.AutomationId="HeaderTitleText"
            FontSize="14"
            FontWeight="Bold"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{DynamicResource ProgramPickerHeader}" />

        <!--  Search bar  -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <TextBox
                Name="SearchTextBox"
                Height="34"
                Padding="30,0,10,0"
                VerticalContentAlignment="Center"
                Background="{DynamicResource InputBackgroundBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}"
                BorderThickness="1"
                FontSize="12"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="{DynamicResource TextSecondaryBrush}"
                IsHitTestVisible="False"
                Text="🔍" />
            <TextBlock
                Margin="30,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="SearchPlaceholderText"
                FontSize="12"
                Foreground="{DynamicResource TextSecondaryBrush}"
                IsHitTestVisible="False"
                Opacity="0.6"
                Text="{DynamicResource ProgramPickerPlaceholder}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!--  List View  -->
        <Border
            Grid.Row="2"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ListView
                Name="ProgramsListView"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding DisplayedPrograms}"
                SelectedItem="{Binding SelectedProgram}"
                SelectionMode="Single">
                <ListView.InputBindings>
                    <MouseBinding Command="{Binding ConfirmCommand}" MouseAction="LeftDoubleClick" />
                </ListView.InputBindings>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel
                            Height="44"
                            Margin="6,4"
                            Orientation="Horizontal">
                            <Image
                                Width="32"
                                Height="32"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Source="{Binding IconSource}"
                                Stretch="Uniform" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="{Binding Name}" />
                                <TextBlock
                                    Width="330"
                                    Margin="0,2,0,0"
                                    FontSize="10"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="{Binding FriendlyPath}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!--  Loading / Status indicator  -->
        <TextBlock
            Name="StatusTextBlock"
            Grid.Row="3"
            Margin="0,6,0,6"
            FontSize="12"
            FontWeight="Medium"
            Text="{Binding StatusText}"
            Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVis}}">
            <!--  颜色必须走 Style 触发器：本地 Foreground 值会压过 DataTrigger  -->
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Foreground" Value="Red" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!--  Bottom Actions  -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Height="32"
                Padding="14,0"
                AutomationProperties.AutomationId="ManualBrowseButton"
                Command="{Binding BrowseManuallyCommand}"
                Content="{DynamicResource BtnManualBrowse}"
                Style="{StaticResource ModernButtonStyle}" />
            <Button
                Grid.Column="2"
                Width="84"
                Height="32"
                Margin="0,0,8,0"
                AutomationProperties.AutomationId="OkButton"
                Command="{Binding ConfirmCommand}"
                Content="{DynamicResource BtnConfirm}"
                FontWeight="Bold"
                Style="{StaticResource PrimaryButtonStyle}" />
            <Button
                Grid.Column="3"
                Width="84"
                Height="32"
                AutomationProperties.AutomationId="CancelButton"
                Click="Cancel_Click"
                Content="{DynamicResource BtnCancel}"
                Style="{StaticResource ModernButtonStyle}" />
        </Grid>
    </Grid>
</Window>
