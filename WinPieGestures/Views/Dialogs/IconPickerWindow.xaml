<Window
    x:Class="WinPieGestures.Views.Dialogs.IconPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="选择动作矢量图标 (Vector Icon Picker)"
    Width="600"
    Height="480"
    Background="{DynamicResource WindowBackgroundBrush}"
    FontFamily="Segoe UI, Microsoft YaHei UI, Arial"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="SingleBorderWindow">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock
                AutomationProperties.AutomationId="HeaderTitleText"
                FontSize="18"
                FontWeight="Bold"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="{DynamicResource IconPickerHeader}" />
            <TextBlock
                Margin="0,2,0,0"
                AutomationProperties.AutomationId="HeaderSubtitleText"
                FontSize="12"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{DynamicResource IconPickerSubtitle}" />
        </StackPanel>

        <!--  Category Filter & Search & Import  -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Height="32"
                Padding="8,4"
                VerticalContentAlignment="Center"
                AutomationProperties.AutomationId="SearchTextBox"
                Background="{DynamicResource InputBackgroundBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{DynamicResource IconPickerSearchTooltip}" />
            <Button
                Grid.Column="1"
                Height="32"
                Margin="8,0,0,0"
                AutomationProperties.AutomationId="ImportIconButton"
                Command="{Binding ImportIconCommand}"
                Content="{DynamicResource IconPickerImport}"
                Style="{StaticResource ModernButtonStyle}"
                ToolTip="{DynamicResource IconPickerImportTooltip}" />
            <Button
                Grid.Column="2"
                Height="32"
                Margin="8,0,0,0"
                AutomationProperties.AutomationId="ClearIconButton"
                Command="{Binding ClearIconCommand}"
                Content="{DynamicResource IconPickerClear}"
                Style="{StaticResource ModernButtonStyle}" />
        </Grid>

        <!--  Icons Grid  -->
        <Border
            Grid.Row="2"
            Padding="10"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <WrapPanel
                    x:Name="IconsWrapPanel"
                    ItemHeight="84"
                    ItemWidth="88" />
            </ScrollViewer>
        </Border>

        <!--  Bottom Action Bar  -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    AutomationProperties.AutomationId="SelectedIconPrefixText"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="{DynamicResource IconPickerSelected}" />
                    <Run Text=" " />
                </TextBlock>
                <TextBlock
                    x:Name="SelectedIconNameLabel"
                    Margin="4,0,0,0"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="{DynamicResource AccentPrimaryBrush}"
                    Text="{Binding SelectedIconDisplayName}" />
            </StackPanel>

            <Button
                Grid.Column="1"
                Width="90"
                Height="32"
                Margin="0,0,8,0"
                AutomationProperties.AutomationId="ConfirmButton"
                Command="{Binding ConfirmCommand}"
                Content="{DynamicResource BtnConfirm}"
                Style="{StaticResource PrimaryButtonStyle}" />
            <Button
                Grid.Column="2"
                Width="80"
                Height="32"
                AutomationProperties.AutomationId="CancelButton"
                Click="Cancel_Click"
                Content="{DynamicResource BtnCancel}"
                Style="{StaticResource ModernButtonStyle}" />
        </Grid>
    </Grid>
</Window>
