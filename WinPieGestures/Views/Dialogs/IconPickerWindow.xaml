<Window x:Class="WinPieGestures.Views.Dialogs.IconPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择动作矢量图标 (Vector Icon Picker)" Height="480" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        FontFamily="Segoe UI, Microsoft YaHei UI, Arial">

    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonDefaultBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonDefaultBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultFgBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBgBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock AutomationProperties.AutomationId="HeaderTitleText" Text="{DynamicResource IconPickerHeader}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock AutomationProperties.AutomationId="HeaderSubtitleText" Text="{DynamicResource IconPickerSubtitle}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Category Filter & Search & Import -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox AutomationProperties.AutomationId="SearchTextBox" Height="32" Padding="8,4" VerticalContentAlignment="Center"
                     Background="{DynamicResource InputBackgroundBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource InputBorderBrush}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource IconPickerSearchTooltip}"/>
            <Button Grid.Column="1" AutomationProperties.AutomationId="ImportIconButton" Content="{DynamicResource IconPickerImport}" Style="{StaticResource ModernButtonStyle}" Height="32" Margin="8,0,0,0" Command="{Binding ImportIconCommand}" ToolTip="{DynamicResource IconPickerImportTooltip}"/>
            <Button Grid.Column="2" AutomationProperties.AutomationId="ClearIconButton" Content="{DynamicResource IconPickerClear}" Style="{StaticResource ModernButtonStyle}" Height="32" Margin="8,0,0,0" Command="{Binding ClearIconCommand}"/>
        </Grid>

        <!-- Icons Grid -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="IconsWrapPanel" ItemWidth="88" ItemHeight="84"/>
            </ScrollViewer>
        </Border>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock AutomationProperties.AutomationId="SelectedIconPrefixText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"><Run Text="{DynamicResource IconPickerSelected}"/><Run Text=" "/></TextBlock>
                <TextBlock x:Name="SelectedIconNameLabel" Text="{Binding SelectedIconDisplayName}" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12" Margin="4,0,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" AutomationProperties.AutomationId="ConfirmButton" Content="{DynamicResource BtnConfirm}" Style="{StaticResource PrimaryButtonStyle}" Width="90" Height="32" Margin="0,0,8,0" Command="{Binding ConfirmCommand}"/>
            <Button Grid.Column="2" AutomationProperties.AutomationId="CancelButton" Content="{DynamicResource BtnCancel}" Style="{StaticResource ModernButtonStyle}" Width="80" Height="32" Click="Cancel_Click"/>
        </Grid>
    </Grid>
</Window>
