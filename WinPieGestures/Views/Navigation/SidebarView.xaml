<UserControl x:Class="WinPieGestures.Views.Navigation.SidebarView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignHeight="640" d:DesignWidth="230">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 解析期 StaticResource 自合并共享样式字典(与主框架合并同源) -->
                <ResourceDictionary Source="../Styles/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 左侧导航栏 (T19)：导航项数据驱动（图标/标题/目标 VM 类型/选中态），
         由主框架 VM 的 NavigationItems 提供；AutomationId 沿用 NavTab{0..4} 供 e2e 使用。 -->
    <Border Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0" Padding="16,20,16,15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Sidebar Header (Logo & Brand) -->
            <StackPanel Grid.Row="0" Margin="0,5,0,24">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Modern StarPie Squircle Logo -->
                    <Border Width="38" Height="38" CornerRadius="8" Background="Transparent" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#000000" Opacity="0.16"/>
                        </Border.Effect>
                        <Image Source="/logo.png" Width="38" Height="38" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="StarPie" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock AutomationProperties.AutomationId="SidebarSubtitleText" Text="{DynamicResource AppSubtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Five-Dimension Navigation (Data-Driven) -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding NavigationItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource NavTabRadioButtonStyle}" GroupName="SidebarTabs"
                                     AutomationProperties.AutomationId="{Binding AutomationId}"
                                     AutomationProperties.Name="{Binding Title}"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=RadioButton}, Path=Foreground}"
                                      Data="{Binding IconData}"/>
                                <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Version Footer -->
            <StackPanel Grid.Row="2" Margin="0,15,0,5">
                <Border Background="{DynamicResource NavTabActiveBgBrush}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,4">
                    <TextBlock Text="v1.4.1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                </Border>
                <TextBlock Text="© 2026 StarPie" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
