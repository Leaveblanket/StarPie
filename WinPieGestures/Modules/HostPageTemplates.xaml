<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:StarPie.ViewModels.Pages"
                    xmlns:pages="clr-namespace:StarPie.Views.Pages">

    <!-- Host 页面模板字典（B3/#76，ADR-0016 决策 4：外观聚合页壳目标态留 Host；单程序集内与
         M1/M5 同形先行验证“模块模板字典 + App 级合并”路径）。页面 View 无参构造、按导航重建、不经容器。 -->
    <DataTemplate DataType="{x:Type vm:AppearanceSettingsViewModel}">
        <pages:AppearanceSettingsPage/>
    </DataTemplate>
</ResourceDictionary>
