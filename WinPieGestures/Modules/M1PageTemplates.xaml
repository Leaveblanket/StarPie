<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:WinPieGestures.ViewModels.Pages"
                    xmlns:pages="clr-namespace:WinPieGestures.Views.Pages">

    <!-- M1 页面模板字典（B3/#76，ADR-0016 决策 4：模块自带 DataTemplate，Host 每模块一次静态合并；
         B9 随 M1 抽取为 StarPie.Gestures 时整体迁出）。页面 View 无参构造、按导航重建、不经容器。 -->
    <DataTemplate DataType="{x:Type vm:BehaviorSettingsViewModel}">
        <pages:TriggerSettingsPage/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProfileListViewModel}">
        <pages:GesturesSettingsPage/>
    </DataTemplate>
</ResourceDictionary>
