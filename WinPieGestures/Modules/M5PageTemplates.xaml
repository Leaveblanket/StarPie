<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:WinPieGestures.ViewModels.Pages"
                    xmlns:pages="clr-namespace:WinPieGestures.Views.Pages">

    <!-- M5 页面模板字典（B3/#76，ADR-0016 决策 4：模块自带 DataTemplate，Host 每模块一次静态合并；
         B6 随 M5 抽取为 StarPie.Shell 时整体迁出）。页面 View 无参构造、按导航重建、不经容器。 -->
    <DataTemplate DataType="{x:Type vm:GeneralSettingsViewModel}">
        <pages:AdvancedSettingsPage/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AboutViewModel}">
        <pages:AboutSettingsPage/>
    </DataTemplate>
</ResourceDictionary>
