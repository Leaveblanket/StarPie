<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- ADR-0013/#48：net8.0-windows10.0.19041.0 提供 WinRT UISettings(ColorValuesChanged) 投影 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>assets\app_icon.ico</ApplicationIcon>
    <AssemblyName>StarPie</AssemblyName>
    <Title>StarPie</Title>
    <Product>StarPie</Product>
    <Company>StarPie Studio</Company>
    <Description>StarPie - 现代化高颜值 Windows 鼠标轮盘笔势与效率管理系统</Description>
    <Version>1.4.1</Version>
    <AssemblyVersion>1.4.1.0</AssemblyVersion>
    <FileVersion>1.4.1.0</FileVersion>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- B2/#75：共享内核程序集引用（Models/S2/S3/S4/S1/S6 契约/S5 导航内核随迁） -->
    <ProjectReference Include="..\StarPie.Core\StarPie.Core.csproj" />
    <!-- B4/#77：M3 模块程序集显式引用（ProgramScanner/ProgramCatalog/ShortcutResolver 随迁；
         组合根回填 IconAssets.ResolveShortcutTarget 与注入扫描图标委托用） -->
    <ProjectReference Include="..\StarPie.Programs\StarPie.Programs.csproj" />
    <!-- B6/#79：M5 模块程序集显式引用（TrayIconManager/MemoryOptimizer/General+About 设置面随迁；
         组合根调 ShellModuleRegistrar 装配导航与页面 VM DI、AppHost 装配托盘对象用） -->
    <ProjectReference Include="..\StarPie.Shell\StarPie.Shell.csproj" />
    <!-- B7/#80：M4 界面主题模块程序集显式引用（ThemeService/ThemePaletteManager/主题字典/
         主题设置子 VM 随迁；组合根调 ThemeModuleRegistrar 注册服务与主题 VM DI、
         AppHost 装配 ThemePaletteManager 调色板换入面用） -->
    <ProjectReference Include="..\StarPie.Theme\StarPie.Theme.csproj" />
  </ItemGroup>

</Project>
