<Application x:Class="WinPieGestures.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:WinPieGestures.Views.Converters">
    <!--
        No StartupUri: the initial settings window is created by the composition root
        (Composition.Run) so constructor-injected services are wired first. ADR-0003.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Light 主题默认/设计时画刷 (ADR-0012)：运行时由 AppHost 按主题覆盖为 Application 直接资源  -->
                <ResourceDictionary Source="Views/Styles/Themes/Light.xaml" />
                <!--  全局控件样式 (ADR-0012)：隐式默认 + 键控变体 + 共享模板，App 级单点合并  -->
                <ResourceDictionary Source="Views/Styles/ModernControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
            <converters:StringToGeometryConverter x:Key="StringToGeometryConverter" />
            <converters:IntEqualsConverter x:Key="IntEqualsConverter" />
            <converters:CoreIconGeometryConverter x:Key="CoreIconGeometryConverter" />
            <converters:CoreIconNameConverter x:Key="CoreIconNameConverter" />
            <converters:FilePathToImageConverter x:Key="FilePathToImageConverter" />
            <!--  Global Crisp Typography & ClearType Rules  -->
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
            </Style>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
