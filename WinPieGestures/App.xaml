<Application x:Class="WinPieGestures.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- No StartupUri: the initial settings window is created by the composition root
         (Composition.Run) so constructor-injected services are wired first. ADR-0003. -->
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="ItemHoverBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="SubtleCardBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="NavTabDefaultBgBrush" Color="#00000000"/>
        <SolidColorBrush x:Key="NavTabDefaultFgBrush" Color="#475569"/>
        <SolidColorBrush x:Key="NavTabHoverBgBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="NavTabHoverFgBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="NavTabActiveBgBrush" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="NavTabActiveFgBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="ButtonDefaultBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ButtonDefaultFgBrush" Color="#334155"/>
        <SolidColorBrush x:Key="ButtonDefaultBorderBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="ButtonHoverBgBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
        <!-- Global Crisp Typography & ClearType Rules -->
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
    </Application.Resources>
</Application>
