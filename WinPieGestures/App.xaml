<Application
    x:Class="WinPieGestures.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:WinPieGestures.Views.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Light 主题默认/设计时画刷  -->
                <ResourceDictionary Source="Views/Styles/Themes/Light.xaml" />
                <!--  全局控件样式 (ADR-0012)  -->
                <ResourceDictionary Source="Views/Styles/ModernControls.xaml" />
                <!--  B3/#76 模块页面模板字典（ADR-0016 决策 4：Host 每模块一次静态合并；
                      M1/M5/Host 临时注册器 + 模板字典，单程序集内先行，随 B6/B9 拆集迁出）  -->
                <ResourceDictionary Source="Modules/M1PageTemplates.xaml" />
                <ResourceDictionary Source="Modules/M5PageTemplates.xaml" />
                <ResourceDictionary Source="Modules/HostPageTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
            <converters:StringToGeometryConverter x:Key="StringToGeometryConverter" />
            <converters:IntEqualsConverter x:Key="IntEqualsConverter" />
            <converters:CoreIconGeometryConverter x:Key="CoreIconGeometryConverter" />
            <converters:CoreIconNameConverter x:Key="CoreIconNameConverter" />
            <converters:FilePathToImageConverter x:Key="FilePathToImageConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
